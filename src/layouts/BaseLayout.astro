---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PodcastStrip from '../components/PodcastStrip.astro';
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { isNoindexPath } from '../lib/noindex-routes';
import { alternatesFor } from '../lib/hreflang';

interface Props {
  pageTitle: string;
  description?: string;
  image?: string;
  translationUrl?: string; // exact URL for the other-language version of this page
  /**
   * Whether this page really has a counterpart in the other language. Only
   * dynamic routes need to say -- a blog post is translated or it isn't --
   * and passing false suppresses the hreflang tags. Static pages leave it
   * unset and are paired by the /tr mirror rule.
   *
   * Deliberately separate from translationUrl above, which falls back to the
   * listing page for an untranslated post. That is right for the language
   * switcher and wrong here: claiming /tr/blog as one post's Turkish version
   * is a pairing Google would not see claimed back.
   */
  translationExists?: boolean;
  /** 'article' for a blog post; anything else is a page. */
  ogType?: 'website' | 'article';
}

const { pageTitle, ogType = 'website', description = 'RSG Turkiye - ISCB Student Council Regional Student Group for computational biology and bioinformatics in Turkiye.', image = '', translationUrl, translationExists } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || '/logo/rsgturkey_logo.png';
const noindex = isNoindexPath(Astro.url.pathname);
const site = Astro.site;
const resolvedImageURL = new URL(ogImage, site).href;
// translationUrl is the exact counterpart when a page knows it; without it
// the pair is derived from the path, which assumes the slugs match.
const alternates = translationExists === false ? null : alternatesFor(Astro.url.pathname, translationUrl);
const alternateHref = (path: string) => new URL(path, site).href;
---
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Inter, in three requests instead of four. The stylesheet used to be
         pulled with @import from inside global.css, which meant the browser
         had to fetch and parse our CSS before it learned that a font
         stylesheet existed, and fetch that before it learned where the font
         files were: HTML, our CSS, Google's CSS, the woff2. Declaring it here
         starts the font stylesheet alongside our own, and the two preconnects
         open the TLS connections while the HTML is still being read. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" />
    <!-- 64px, not the 1280x1280 original: this is drawn in a browser tab at
         16 or 32 pixels and the full-size logo cost 377 KB on every first
         visit. public/favicon.svg is Astro's default logo, not ours. -->
    <link rel="icon" type="image/png" href="/logo/favicon-64.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Not `{pageTitle} | RSG Turkiye`: every page already puts the brand in
         its own pageTitle, so that produced "Webinars - RSG Turkiye | RSG
         Turkiye" in the tab, and on Turkish pages the two halves disagreed
         about the ü. -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {/* Leaving these out of the sitemap only stops us advertising them; this is
        what keeps them out of the index when Google finds them another way.
        "follow" so the ordinary navigation links on the page are still crawled. */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Tells Google these two URLs are the same page in two languages, so it
        serves the right one and treats them as one piece of content rather
        than two. Each page lists itself as well as its counterpart -- that is
        per spec. x-default is the fallback for languages we don't cover. */}
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={alternateHref(alternates.en)} />
        <link rel="alternate" hreflang="tr" href={alternateHref(alternates.tr)} />
        <link rel="alternate" hreflang="x-default" href={alternateHref(alternates.en)} />
      </>
    )}

    <!-- Open Graph -->
    <!-- An article when the page is one; 34 blog posts were announcing
         themselves as a website. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />

    <!-- Twitter -->
    <!-- summary_large_image with the square logo cropped it on every share,
         and made every crawler fetch 598 KB. A page with its own image keeps
         the large card; the rest get the small one the logo actually suits. -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />

    <!-- RSS Feed -->
    <!-- One feed per language; a Turkish reader subscribing from a Turkish
         page should not get the English one. -->
    <link rel="alternate" type="application/rss+xml" title="RSG Türkiye Blog RSS"
      href={lang === 'tr' ? '/tr/rss.xml' : '/rss.xml'} />

    <!-- Translation URL: used by the language switcher to navigate to the correct page -->
    {translationUrl && <meta name="translation-url" content={translationUrl} />}

    <!-- Extra head content (JSON-LD, etc.) injected by individual pages -->
    <slot name="head" />

    <!-- Structured Data: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "RSG Turkiye",
      "url": "https://rsg-turkiye.iscbsc.org",
      "logo": "https://rsg-turkiye.iscbsc.org/logo/rsgturkey_logo.png",
      "description": "ISCB Student Council Regional Student Group for computational biology and bioinformatics in Turkiye.",
      "sameAs": [
        "https://twitter.com/RSGTurkiye",
        "https://www.linkedin.com/company/rsgturkey"
      ],
      "memberOf": {
        "@type": "Organization",
        "name": "ISCB Student Council",
        "url": "https://iscbsc.org"
      }
    })} />
  </head>
  <body>
    <Header />
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
    <PodcastStrip lang={lang} />
  </body>
</html>
