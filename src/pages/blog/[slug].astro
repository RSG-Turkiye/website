---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostView from '../../components/BlogPostView.astro';
import { getCollection } from 'astro:content';
import { counterpartSlug } from '../../lib/translations';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  return all
    .filter((p) => p.id.startsWith('en/'))
    .map((post) => ({
      params: { slug: post.id.slice(3) },
      props: { post, twinSlug: counterpartSlug(all, post.id, 'tr') },
    }));
}

const { post, twinSlug } = Astro.props;
const { title, description } = post.data;
---

<BaseLayout pageTitle={title} description={description}
  translationUrl={twinSlug ? `/tr/blog/${twinSlug}` : '/tr/blog'}
  translationExists={twinSlug !== null} ogType="article">
  <BlogPostView lang="en" post={post} twinSlug={twinSlug} />
</BaseLayout>

<!-- post-content prose styles live in global.css -->
