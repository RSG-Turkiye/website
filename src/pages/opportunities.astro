---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpportunityBoard from '../components/OpportunityBoard.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout pageTitle="Opportunities - RSG-Turkiye" translationUrl="/tr/firsatlar"
  description="Scholarships, PhD positions, internships, courses and hackathons for bioinformatics students, collected automatically.">
  <div class="bg-navy py-12 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl font-bold text-white">{t('opps.title')}</h1>
      <p class="text-white/70 mt-2">{t('opps.subtitle')}</p>
    </div>
  </div>
  <OpportunityBoard lang={lang} />
</BaseLayout>
