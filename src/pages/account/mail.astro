---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
const target = '/admin#eposta/yaz';
---

<BaseLayout
  pageTitle="Send mail as RSG, RSG-Turkiye"
  description="Send mail from the RSG-Turkiye address."
  translationUrl="/tr/account/mail"
>
  <div class="min-h-screen bg-[#F7F7F6] py-12 px-4">
    <div class="max-w-3xl mx-auto text-center py-24">
      <a id="mailMovedLink" href={target} class="text-navy-mid hover:underline text-sm">{t('account.mailMoved')}</a>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ target }}>
  location.replace(target);
</script>
