---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideUniversity from '../../components/guide/GuideUniversity.astro';

export async function getStaticPaths() {
  return (await getCollection('guideUniversities')).map((e) => ({ params: { university: e.data.id }, props: { university: e.data } }));
}
const { university } = Astro.props;
---

<BaseLayout hidePodcast pageTitle={`${university.name.en} - Graduate guide`}
  description={`MSc programmes and bioinformatics professors at ${university.name.en}, ${university.city}.`}>
  <GuideUniversity lang="en" university={university} />
</BaseLayout>
