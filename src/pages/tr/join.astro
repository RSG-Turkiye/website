---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageText } from '../../lib/page-text';

const pageTitle = "Bize Katıl - RSG-Türkiye";
const tx = await pageText('join', 'tr');

const faqs = [
  {
    q: tx('faq_how_to_join_q'),
    a: tx('faq_how_to_join_a'),
  },
  {
    q: tx('faq_international_q'),
    a: tx('faq_international_a'),
  },
  {
    q: tx('faq_stay_updated_q'),
    a: tx('faq_stay_updated_a'),
  },
  {
    q: tx('faq_propose_topic_q'),
    a: tx('faq_propose_topic_a'),
  },
];

const benefits = [
  { title: tx('benefit_network_title'), desc: tx('benefit_network_desc') },
  { title: tx('benefit_learning_title'), desc: tx('benefit_learning_desc') },
  { title: tx('benefit_community_title'), desc: tx('benefit_community_desc') },
  { title: tx('benefit_career_title'), desc: tx('benefit_career_desc') },
  { title: tx('benefit_collaboration_title'), desc: tx('benefit_collaboration_desc') },
  { title: tx('benefit_events_title'), desc: tx('benefit_events_desc') },
];
---

<BaseLayout pageTitle={pageTitle}
  description="RSG-Türkiye'ye nasıl katılınır: kimler üye olabilir, komiteler ne yapar ve nasıl yer alınır.">

  <div class="bg-navy py-12 text-center">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="text-3xl font-bold text-white">{tx('hero_title')}</h1>
      <p class="text-white/70 mt-2">{tx('hero_subtitle')}</p>
    </div>
  </div>

  <section id="follow" class="bg-[#F7F7F6] py-10 border-b border-border scroll-mt-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-xl font-semibold text-navy mb-2">{tx('follow_title')}</h2>
      <p class="text-sm text-gray-600 mb-4">{tx('follow_text')}</p>
      <div class="flex flex-wrap gap-2">
          <a href="https://instagram.com/rsgturkey" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 rounded-md border border-navy text-navy text-sm font-medium hover:bg-navy-light transition-colors no-underline">Instagram</a>
          <a href="https://linkedin.com/company/rsgturkey" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 rounded-md border border-navy text-navy text-sm font-medium hover:bg-navy-light transition-colors no-underline">LinkedIn</a>
          <a href="https://www.youtube.com/@RSG-Turkiye" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 rounded-md border border-navy text-navy text-sm font-medium hover:bg-navy-light transition-colors no-underline">YouTube</a>
          <a href="https://twitter.com/rsgturkey" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 rounded-md border border-navy text-navy text-sm font-medium hover:bg-navy-light transition-colors no-underline">X</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <!-- Benefits -->
        <div>
          <h2 class="text-xl font-semibold text-navy mb-6">{tx('benefits_title')}</h2>
          <ul class="flex flex-col">
            {benefits.map((b) => (
              <li class="py-3 border-b border-border flex flex-col gap-0.5">
                <strong class="text-navy text-sm">{b.title}</strong>
                <span class="text-sm text-gray-500">{b.desc}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Form embed -->
        <div>
          <h2 id="membership" class="text-xl font-semibold text-navy mb-2 scroll-mt-20">{tx('membership_title')}</h2>
          <p class="text-sm text-gray-600 mb-6">{tx('membership_text')}</p>
          <iframe
            src="https://docs.google.com/forms/d/e/1FAIpQLSeo8lI8mijdndi2Z0hURHUbn2mvJPkbW9OrsgQ2bH9iGfyS_g/viewform?embedded=true"
            width="100%"
            height="900"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            class="rounded-lg border border-border"
            title="RSG-Türkiye Üyelik Başvuru Formu"
          >
            Form yükleniyor…
          </iframe>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[#F7F7F6] py-14 border-t border-border">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-xl font-semibold text-navy text-center mb-8">{tx('faq_title')}</h2>
      <div class="flex flex-col gap-2">
        {faqs.map((faq) => (
          <div class="bg-white border border-border rounded-lg overflow-hidden">
            <button
              class="w-full flex justify-between items-center px-5 py-4 text-left text-sm font-medium text-navy hover:bg-navy-light transition-colors"
              aria-expanded="false"
              data-faq-toggle
            >
              {faq.q}
              <span class="text-xl font-light text-gray-500 ml-4 shrink-0">+</span>
            </button>
            <div class="px-5 pb-4 text-sm text-gray-600 leading-relaxed" style="display:none;">
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
<script>
  // Attached rather than inline: an onclick attribute is a script a
  // Content-Security-Policy cannot tell from an injected one. The behaviour is
  // unchanged -- aria-expanded still carries the state, so a screen reader
  // reads the same thing it did.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-faq-toggle]')) {
    button.addEventListener('click', () => {
      const panel = button.nextElementSibling as HTMLElement | null;
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      if (panel) panel.style.display = open ? 'none' : 'block';
      const sign = button.querySelector('span');
      // The plus never became a minus; it does now, which is the state the
      // sighted reader was missing.
      if (sign) sign.textContent = open ? '+' : '−';
    });
  }
</script>

