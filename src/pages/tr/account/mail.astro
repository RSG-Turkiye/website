---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/ui';
const t = useTranslations('tr');
const target = '/tr/admin#eposta/yaz';
---

<BaseLayout
  pageTitle="RSG Adına Mail Gönder, RSG-Türkiye"
  description="RSG-Türkiye adresinden mail gönder."
  translationUrl="/account/mail"
>
  <div class="min-h-screen bg-[#F7F7F6] py-12 px-4">
    <div class="max-w-3xl mx-auto text-center py-24">
      <a id="mailMovedLink" href={target} class="text-navy-mid hover:underline text-sm">{t('account.mailMoved')}</a>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ target }}>
  location.replace(target);
</script>
