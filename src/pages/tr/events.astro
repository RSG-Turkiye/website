---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventList from '../../components/EventList.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'tr' as const;
const t = useTranslations(lang);
const pageTitle = "Etkinlikler - RSG-Türkiye";
---

<BaseLayout pageTitle={pageTitle}
  description="RSG-Türkiye'nin yaklaşan ve geçmiş etkinlikleri: yıllık öğrenci sempozyumu, atölyeler ve topluluk buluşmaları.">

  <!-- Sayfa Başlığı -->
  <div class="bg-navy py-12 text-center">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="text-3xl font-bold text-white">{t('events.title')}</h1>
      <p class="text-white/70 mt-2">{t('events.subtitle')}</p>
    </div>
  </div>

  <EventList lang={lang} />

</BaseLayout>
