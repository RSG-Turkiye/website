---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OpportunityBoard from '../../components/OpportunityBoard.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'tr' as const;
const t = useTranslations(lang);
---

<BaseLayout pageTitle="Fırsatlar - RSG-Türkiye" translationUrl="/opportunities"
  description="Biyoinformatik öğrencileri için burslar, doktora pozisyonları, stajlar, kurslar ve hackathonlar; otomatik olarak toplanır.">
  <div class="bg-navy py-12 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl font-bold text-white">{t('opps.title')}</h1>
      <p class="text-white/70 mt-2">{t('opps.subtitle')}</p>
    </div>
  </div>
  <OpportunityBoard lang={lang} />
</BaseLayout>
