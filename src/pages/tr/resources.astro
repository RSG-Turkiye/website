---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadResources } from '../../lib/get-resources';
import { resourcesFor } from '../../data/resources';
import { pageText } from '../../lib/page-text';
const tx = await pageText('resources', 'tr');
const pageTitle = "Kaynaklar - RSG-Türkiye";

const sections = [
  { id: "learning",  label: tx('section_learning') },
  { id: "md-drug",   label: tx('section_md_drug') },
  { id: "databases", label: tx('section_databases') },
  { id: "tools",     label: tx('section_tools') },
  { id: "community", label: tx('section_community') },
];

const all = await loadResources();
const learningResources = resourcesFor(all, "learning", "tr");
const mdResources = resourcesFor(all, "md-drug", "tr");
const databases = resourcesFor(all, "databases", "tr");
const tools = resourcesFor(all, "tools", "tr");
const community = resourcesFor(all, "community", "tr");

const allSections = [
  { id: "learning",  label: tx('section_learning'),        items: learningResources },
  { id: "md-drug",   label: tx('section_md_drug'),         items: mdResources },
  { id: "databases", label: tx('section_databases'),       items: databases },
  { id: "tools",     label: tx('section_tools'),           items: tools },
  { id: "community", label: tx('section_community'),       items: community },
];
---

<BaseLayout pageTitle={pageTitle}
  description="RSG-Türkiye'nin derlediği biyoinformatik kaynakları: veri tabanları, araçlar, dersler ve okumalar, konuya göre aranabilir.">

  <div class="bg-navy py-12 text-center">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="text-3xl font-bold text-white">{tx('hero_title')}</h1>
      <p class="text-white/70 mt-2">{tx('hero_subtitle')}</p>
    </div>
  </div>

  <section class="bg-white py-12">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-10 items-start">

        <!-- Sticky sidebar -->
        <aside class="hidden lg:flex flex-col gap-1 sticky top-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-3">{tx('sidebar_sections_heading')}</p>
          {sections.map(s => (
            <a href={`#${s.id}`} data-nav={s.id}
              class="nav-link text-sm text-gray-500 hover:text-navy py-1.5 border-l-2 border-transparent hover:border-navy pl-3 no-underline transition-all duration-150">
              {s.label}
            </a>
          ))}

          <!-- Search -->
          <div class="mt-6 pt-5 border-t border-border">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">{tx('sidebar_search_heading')}</p>
            <input
              id="resourceSearch"
              type="text"
              placeholder={tx('search_placeholder')}
              class="w-full border border-border rounded-md px-3 py-2 text-sm focus:outline-none focus:border-navy-mid transition-colors"
            />
          </div>

          <!-- Legend -->
          <div class="mt-4">
            <span class="inline-flex items-center gap-1.5 text-xs text-green-700 font-medium px-2 py-1 rounded bg-green-50 border border-green-200">
              ✓ {tx('open_source_badge')}
            </span>
            <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">{tx('open_source_legend')}</p>
          </div>

          <!-- No results -->
          <p id="noResults" class="hidden text-xs text-gray-500 mt-4 italic">{tx('sidebar_no_matches')}</p>
        </aside>

        <!-- Main content -->
        <div class="flex flex-col gap-16" id="resourceContent">
          <!-- The active filter, and the way out of it.
               Tapping a tag chip filters the list, and the search box that
               would undo it lives in a sidebar that is `hidden lg:flex` -- so
               below 1024px a reader could start a filter and had no way to
               clear it but a page reload, with no message when nothing
               matched. This sits in the main column, at every width. -->
          <div id="activeFilter" class="hidden items-center gap-3 rounded-xl border border-border bg-navy-light px-4 py-3">
            <p class="text-sm text-navy min-w-0 flex-1">
              {tx('active_filter_lead')} <span id="activeFilterTerm" class="font-semibold"></span>
            </p>
            <button id="clearFilter" type="button"
              class="shrink-0 text-xs font-semibold px-3 py-1.5 rounded-lg border border-navy-mid text-navy-mid hover:bg-navy hover:text-white transition-colors">
              {tx('clear_filter_button')}
            </button>
          </div>
          <p id="noResultsMain" class="hidden text-sm text-gray-500 italic">{tx('main_no_matches')}</p>
          {allSections.map(section => (
            <div id={section.id} class="resource-section">
              <div class="flex items-baseline gap-3 mb-6">
                <h2 class="text-lg font-semibold text-navy pb-2 border-b-2 border-navy inline-block">
                  {section.label}
                </h2>
                <span class="section-count text-xs font-medium text-gray-500 tabular-nums">
                  {section.items.length} {tx('section_count_unit')}
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {section.items.map(item => (
                  <div
                    class="resource-card group flex flex-col p-5 rounded-xl border border-border bg-white hover:border-navy-mid hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-default"
                    data-title={item.title.toLowerCase()}
                    data-description={item.description.toLowerCase()}
                    data-tags={item.tags.join(' ').toLowerCase()}
                  >
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <a href={item.url} target="_blank" rel="noopener noreferrer"
                        class="font-semibold text-navy group-hover:text-navy-mid transition-colors leading-snug no-underline">
                        {item.title}
                        <span class="text-navy-mid opacity-60 ml-0.5">→</span>
                      </a>
                      {item.opensource && (
                        <span class="shrink-0 inline-flex items-center gap-1 text-xs text-green-700 font-medium px-1.5 py-0.5 rounded bg-green-50 border border-green-200 whitespace-nowrap">
                          ✓ {tx('open_source_badge')}
                        </span>
                      )}
                    </div>
                    <p class="text-sm text-gray-500 leading-relaxed mb-3 flex-1">{item.description}</p>
                    <div class="flex flex-wrap gap-1.5 mt-auto">
                      {item.tags.map(tag => (
                        <span class="tag-chip inline-block text-xs px-2 py-0.5 rounded bg-navy-light text-navy-mid border border-[#C4CEEA] cursor-pointer hover:bg-navy hover:text-white transition-colors">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // ── Search ──────────────────────────────────────────────────────────────
  const searchInput = document.getElementById('resourceSearch') as HTMLInputElement;
  const noResults   = document.getElementById('noResults')!;
  const cards       = Array.from(document.querySelectorAll<HTMLElement>('.resource-card'));
  const sections    = Array.from(document.querySelectorAll<HTMLElement>('.resource-section'));

  // Keeps the banner and the search box saying the same thing, whichever the
  // reader used.
  const activeFilter = document.getElementById('activeFilter');
  const activeFilterTerm = document.getElementById('activeFilterTerm');
  const noResultsMain = document.getElementById('noResultsMain');
  const clearFilter = document.getElementById('clearFilter');

  function showFilterState(term: string, anyMatch: boolean) {
    if (activeFilter) {
      activeFilter.classList.toggle('hidden', term === '');
      activeFilter.classList.toggle('flex', term !== '');
    }
    if (activeFilterTerm) activeFilterTerm.textContent = term;
    if (noResultsMain) noResultsMain.classList.toggle('hidden', term === '' || anyMatch);
  }

  clearFilter?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    filterResources('');
  });

  function filterResources(term: string) {
    let anyVisible = false;
    cards.forEach(card => {
      const matches = !term
        || (card.dataset.title || '').includes(term)
        || (card.dataset.description || '').includes(term)
        || (card.dataset.tags || '').includes(term);
      card.style.display = matches ? '' : 'none';
      if (matches) anyVisible = true;
    });

    // hide empty sections, update counts
    sections.forEach(section => {
      const visible = Array.from(section.querySelectorAll<HTMLElement>('.resource-card'))
        .filter(c => c.style.display !== 'none');
      section.style.display = visible.length ? '' : 'none';
      const count = section.querySelector('.section-count');
      if (count) count.textContent = `${visible.length} kaynak`;
    });

    noResults.classList.toggle('hidden', anyVisible);
    showFilterState(term, anyVisible);
  }

  searchInput?.addEventListener('input', e => {
    filterResources((e.target as HTMLInputElement).value.toLowerCase().trim());
  });

  // Click tag to search by it
  document.querySelectorAll<HTMLElement>('.tag-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = chip.textContent?.trim() || '';
      if (searchInput) {
        searchInput.value = tag;
        filterResources(tag.toLowerCase());
      }
    });
  });

  // ── Active nav on scroll ────────────────────────────────────────────────
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
  const activeClass    = ['border-navy', 'text-navy', 'font-medium'];
  const inactiveClass  = ['border-transparent', 'text-gray-500'];

  function setActive(id: string) {
    navLinks.forEach(link => {
      const isActive = link.dataset.nav === id;
      activeClass.forEach(c  => link.classList.toggle(c, isActive));
      inactiveClass.forEach(c => link.classList.toggle(c, !isActive));
    });
  }

  const observer = new IntersectionObserver(entries => {
    const visible = entries.filter(e => e.isIntersecting);
    if (visible.length) setActive(visible[0].target.id);
  }, { rootMargin: '-10% 0px -60% 0px', threshold: 0 });

  sections.forEach(s => observer.observe(s));
</script>
