---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { useTranslations } from '../../i18n/ui';
import { getCollection } from 'astro:content';

const lang = 'tr';
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('tr/') && !data.draft && data.type !== 'webinar'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout pageTitle="Blog - RSG-Türkiye"
  description="RSG-Türkiye üyelerinin biyoinformatik, genomik ve hesaplamalı biyoloji yazıları: eğitimler, araç incelemeleri ve araştırma notları.">

  <div class="bg-navy py-12 text-center">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="text-3xl font-bold text-white">{t('blog.title')}</h1>
      <p class="text-white/70 mt-2">{t('blog.subtitle')}</p>
    </div>
  </div>

  <BlogIndex lang={lang} posts={posts} />

</BaseLayout>
