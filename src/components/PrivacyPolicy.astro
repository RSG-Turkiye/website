---
import { PRIVACY, PRIVACY_UPDATED } from '../data/privacy';

interface Props {
  lang: 'en' | 'tr';
}

const { lang } = Astro.props;
const notice = PRIVACY[lang];
---
<div class="bg-navy py-12 text-center">
  <div class="max-w-7xl mx-auto px-6">
    <h1 class="text-3xl font-bold text-white">{notice.title}</h1>
    <p class="mt-2 text-sm text-white/70">{notice.updated}: <time datetime={PRIVACY_UPDATED}>{PRIVACY_UPDATED}</time></p>
  </div>
</div>

<section class="bg-white py-16">
  <div class="max-w-3xl mx-auto px-6">
    {notice.intro.map((p) => <p class="text-gray-600 leading-relaxed mb-3">{p}</p>)}

    {notice.sections.map((section) => (
      <div class="mt-10">
        <h2 class="text-2xl font-semibold text-navy mb-4">{section.heading}</h2>
        {section.paragraphs?.map((p) => <p class="text-gray-600 leading-relaxed mb-3">{p}</p>)}
        {section.items && (
          <ul class="list-disc pl-6 space-y-2 text-gray-600 leading-relaxed">
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </div>
    ))}
  </div>
</section>
