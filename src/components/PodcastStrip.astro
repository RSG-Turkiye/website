---
/**
 * The site's podcast player: one bar, one <audio>, every page.
 *
 * The ask was a horizontal player that plays without having to go anywhere.
 * The first attempt made this a link to /podcast, because I believed a player
 * here would stop at the first navigation and that fixing it meant turning on
 * view transitions, which I thought would stop the site's 32 script blocks
 * from re-running. Both halves of that were wrong, and a headless browser said
 * so: with <ClientRouter /> the audio survives navigation and every page's
 * script still runs on arrival. See BaseLayout.
 *
 * So this is the player, and it is the *only* one on the site. /podcast has no
 * <audio> of its own; its episode buttons drive this one, which is also why
 * two episodes can never play at once.
 *
 * Only the <audio> carries `transition:persist`, not the bar around it. That
 * matters: a persisted element keeps the markup it was first rendered with, so
 * persisting the whole bar froze its language -- a reader who switched to
 * Turkish kept an English "Latest episode" and an English "Play" label. The
 * bar is re-rendered on every page in that page's language; the audio element,
 * with what it is playing and where it has got to, is what crosses over. Its
 * dataset carries the episode title so the fresh bar can put it back.
 *
 * Still nothing plays on its own. Browsers block audio without a gesture,
 * Spotify's embed never supported autoplay, and WCAG 1.4.2 counts more than
 * three seconds of automatic sound as a failure. A fair share of this site's
 * readers are on a university network, in a library, or in a lecture.
 */
import { useTranslations } from '../i18n/ui';
import { latest, formatDuration } from '../lib/podcast';

interface Props {
  lang: 'en' | 'tr';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const href = lang === 'tr' ? '/tr/podcast/' : '/podcast/';
---

{latest && (
  /*
   * No `relative` in the class list, though the timeline is positioned
   * absolutely against this element. Both utilities set `position`, the
   * cascade decides which wins rather than the order they are written in, and
   * adding `relative` took `fixed` away: the bar stopped being pinned to the
   * viewport and sank to the bottom of the document -- 1439px down a 900px
   * window, where nothing could click it. A fixed element is already a
   * containing block for its absolutely positioned children.
   */
  <div
    id="podcastStrip"
    hidden
    class="fixed bottom-0 left-0 right-0 z-40 bg-navy text-white border-t border-white/10"
    data-play={t('podcast.play')}
    data-pause={t('podcast.pause')}
    data-latest-title={latest.title}
    data-latest-audio={latest.audioUrl}
  >
    <!--
      The timeline: a red hairline along the top edge, and how a listener
      moves around inside an episode.

      A range input rather than a div with a click handler, because a range
      input already is this control: dragging, click-to-jump, arrow keys, Home
      and End, a focus ring, and a screen reader that announces a position.
      Rebuilding that on a <div role="slider"> would be a lot of code to
      arrive back where the browser started.

      Two pieces of shaping. The visible line is two pixels but the element is
      fourteen, sitting half above the bar's top edge, because a two-pixel
      target cannot be hit with a mouse and certainly not with a thumb -- the
      line is the appearance, the padding is the control. And the filled part
      is painted with a gradient set from script: WebKit has no pseudo-element
      for the portion left of the thumb, so there is nothing to style.
    -->
    <input
      id="podcastSeek"
      type="range"
      min="0"
      max="0"
      step="1"
      value="0"
      disabled
      aria-label={t('podcast.seek')}
      class="podcast-seek absolute -top-1.5 left-0 w-full h-3.5 m-0 p-0 appearance-none bg-transparent cursor-pointer disabled:cursor-default focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-[54px] flex items-center gap-3">
      <button
        id="podcastToggle"
        type="button"
        aria-label={t('podcast.play')}
        class="shrink-0 w-9 h-9 rounded-full bg-red hover:bg-red-hover transition-colors flex items-center justify-center cursor-pointer border-0 text-white"
      >
        <svg id="podcastIconPlay" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <!-- `class="hidden"` rather than the attribute: Astro's SVG types do
             not carry `hidden`, and the script toggles the class either way. -->
        <svg id="podcastIconPause" class="hidden" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
        </svg>
      </button>

      <a href={href} class="min-w-0 flex-1 no-underline text-white">
        <span class="block text-[10px] font-semibold uppercase tracking-widest text-white/60 leading-none mb-0.5">
          {t('podcast.latest')}
        </span>
        <span id="podcastTitle" class="block text-sm truncate leading-tight">{latest.title}</span>
      </a>

      <span id="podcastTime" class="hidden sm:inline text-xs text-white/60 shrink-0 tabular-nums">
        {formatDuration(latest.durationSeconds, lang)}
      </span>

      <a
        href={href}
        class="hidden sm:inline-flex items-center px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 transition-colors text-sm font-medium no-underline text-white shrink-0"
      >
        {t('podcast.episodes')}
      </a>

      <button
        id="podcastStripClose"
        type="button"
        aria-label={t('podcast.strip.dismiss')}
        class="shrink-0 w-8 h-8 rounded flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-colors cursor-pointer bg-transparent border-0"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!--
      The one element that crosses navigations. No src: the URL arrives on the
      first press, from the button that was pressed, so nothing is fetched
      from a reader who never asked for it.
    -->
    <audio id="podcastAudio" transition:persist="podcast-audio" preload="none"></audio>
  </div>
)}

<script>
  /**
   * The bar is new on every page; the <audio> inside it is the same element
   * throughout. So this runs on every `astro:page-load` -- which fires on a
   * fresh load and after each view transition -- binds the new buttons, and
   * reads the state back off the audio, which is where it lives.
   *
   * Listeners are bound to the audio once and only once, guarded by a flag on
   * the audio itself: it survives navigation, and so would duplicate handlers.
   * `render` is looked up through that flag rather than captured, so the
   * handler bound on the first page always draws into the *current* bar.
   */
  const KEY = 'rsg:podcast-strip-dismissed';

  /** Seconds as m:ss. */
  function mm(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds < 0) return '';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  /** Show the bar, and keep the page's last line clear of it. */
  function show(strip: HTMLElement) {
    strip.hidden = false;
    document.body.style.paddingBottom = `${strip.offsetHeight}px`;
  }

  interface Wired extends HTMLAudioElement {
    /** Draws into the bar currently on screen. Replaced on every page. */
    redraw?: () => void;
    /**
     * Points the player at an episode. Replaced on every page.
     *
     * Not called `load`: HTMLMediaElement already has one, and overwriting it
     * would break the element in a way nothing would report.
     */
    playEpisode?: (url: string, title: string) => void;
  }

  function setUp() {
    const strip = document.getElementById('podcastStrip');
    const audio = document.getElementById('podcastAudio') as Wired | null;
    const toggle = document.getElementById('podcastToggle');
    if (!strip || !audio || !toggle) return;

    const iconPlay = document.getElementById('podcastIconPlay');
    const iconPause = document.getElementById('podcastIconPause');
    const seek = document.getElementById('podcastSeek') as HTMLInputElement | null;
    const time = document.getElementById('podcastTime');
    const title = document.getElementById('podcastTitle');
    const close = document.getElementById('podcastStripClose');

    let dismissed = false;
    try {
      dismissed = localStorage.getItem(KEY) === '1';
    } catch {
      // Private windows and blocked site data throw on read. Showing the bar
      // is the right answer when we cannot know.
    }
    if (!dismissed) show(strip);

    /**
     * True while a finger or pointer is on the timeline. The audio goes on
     * firing timeupdate throughout a drag, and letting it write back into the
     * input would drag the handle out from under the person holding it.
     */
    let scrubbing = false;

    /** Draw the audio's state into this page's bar. */
    const render = () => {
      const playing = !audio.paused && !audio.ended;
      iconPlay?.classList.toggle('hidden', playing);
      iconPause?.classList.toggle('hidden', !playing);
      toggle.setAttribute('aria-label', playing ? strip.dataset.pause ?? '' : strip.dataset.play ?? '');
      // The episode being played, which the fresh bar does not otherwise know.
      if (title && audio.dataset.title) title.textContent = audio.dataset.title;

      const known = Number.isFinite(audio.duration) && audio.duration > 0;
      if (seek) {
        seek.disabled = !known;
        if (known) {
          seek.max = String(audio.duration);
          if (!scrubbing) seek.value = String(audio.currentTime);
          paintSeek(Number(seek.value), audio.duration);
        } else {
          seek.max = '0';
          seek.value = '0';
          paintSeek(0, 0);
        }
      }
      if (time && known) {
        time.textContent = `${mm(audio.currentTime)} / ${mm(audio.duration)}`;
      }
    };
    audio.redraw = render;

    /**
     * The filled portion, and what a screen reader is told. `value` is a
     * number of seconds, which announced on its own would be read out as a
     * bare figure; aria-valuetext makes it a time.
     */
    function paintSeek(at: number, of: number) {
      if (!seek) return;
      seek.style.setProperty('--progress', of > 0 ? `${Math.min(100, (at / of) * 100)}%` : '0%');
      // Nothing loaded: no position to announce. Saying "0:00 / 0:01" would be
      // a screen reader reading out a duration this player has not been told.
      if (of > 0) seek.setAttribute('aria-valuetext', `${mm(at)} / ${mm(of)}`);
      else seek.removeAttribute('aria-valuetext');
    }

    if (seek) {
      // `input` fires throughout a drag, so the audio follows the handle
      // rather than jumping once it is released.
      seek.addEventListener('input', () => {
        const to = Number(seek.value);
        if (Number.isFinite(to)) audio.currentTime = to;
        paintSeek(to, audio.duration || 1);
        if (time && audio.duration > 0) time.textContent = `${mm(to)} / ${mm(audio.duration)}`;
      });
      for (const event of ['pointerdown', 'touchstart']) {
        seek.addEventListener(event, () => { scrubbing = true; });
      }
      for (const event of ['pointerup', 'pointercancel', 'touchend', 'blur']) {
        seek.addEventListener(event, () => { scrubbing = false; });
      }

      /**
       * Arrow keys move by ten seconds, not by one step.
       *
       * A range input's arrow key moves one `step`, and `step` also decides
       * how finely a drag can land -- so a step small enough to scrub with is
       * far too small to walk with. On a fifty-one minute episode the default
       * moved a second per press, which is not a way to get anywhere. Ten
       * seconds is the skip every podcast app uses; Home and End still jump to
       * the ends, and the browser handles those.
       */
      seek.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 10 : event.key === 'ArrowLeft' ? -10 : 0;
        if (step === 0 || !Number.isFinite(audio.duration) || audio.duration <= 0) return;
        event.preventDefault();
        const to = Math.min(audio.duration, Math.max(0, audio.currentTime + step));
        audio.currentTime = to;
        seek.value = String(to);
        paintSeek(to, audio.duration);
      });
    }

    const start = () => void audio.play().catch(() => {});

    /** Point the player at an episode, or toggle the one already loaded. */
    const load = (url: string, episodeTitle: string) => {
      if (audio.dataset.loaded === url) {
        if (audio.paused) start();
        else audio.pause();
        return;
      }
      audio.dataset.loaded = url;
      audio.dataset.title = episodeTitle;
      audio.src = url;
      render();
      start();
    };
    audio.playEpisode = load;

    toggle.addEventListener('click', () => {
      // Nothing chosen yet: the newest episode is what the bar is showing.
      load(audio.dataset.loaded ?? strip.dataset.latestAudio ?? '', audio.dataset.title ?? strip.dataset.latestTitle ?? '');
    });

    close?.addEventListener('click', () => {
      audio.pause();
      strip.hidden = true;
      document.body.style.paddingBottom = '';
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        // Closed for this page only, which beats refusing to close.
      }
    });

    if (audio.dataset.bound !== '1') {
      audio.dataset.bound = '1';

      // Bound once, on the audio and on the document -- both of which outlive
      // any single page. Everything they touch goes through `redraw` and
      // `playEpisode`, which the current page replaces, so a handler bound on
      // the first page always acts on the bar that is on screen now.
      for (const event of ['play', 'pause', 'ended', 'timeupdate', 'loadedmetadata']) {
        audio.addEventListener(event, () => audio.redraw?.());
      }

      /**
       * How /podcast starts an episode. An event rather than a shared
       * function: the two components need no reference to each other, and it
       * works the same whether that page was opened directly or navigated to.
       */
      document.addEventListener('rsg:play-episode', ((event: CustomEvent<{ url?: string; title?: string }>) => {
        const detail = event.detail;
        if (!detail?.url) return;
        // Starting something is an answer to having dismissed the bar.
        const current = document.getElementById('podcastStrip');
        if (current) {
          show(current);
          try {
            localStorage.removeItem(KEY);
          } catch {
            // Nothing to undo when storage is unavailable.
          }
        }
        audio.playEpisode?.(detail.url, detail.title ?? '');
      }) as EventListener);
    }

    render();
  }

  /*
   * Both, and neither is redundant.
   *
   * `astro:page-load` is fired by <ClientRouter />, and only by it. This ran
   * on that event alone for one commit, and when the router came back out --
   * it was breaking the signed-in header -- the event stopped firing and the
   * player never started. Calling setUp directly is what runs today; the
   * listener is what will run on navigations if view transitions return, and
   * setUp is written to be safe called twice.
   */
  setUp();
  document.addEventListener('astro:page-load', setUp);
</script>

<style>
  /*
    The timeline. Everything here shapes one range input into a hairline: the
    element is 14px tall so it can be hit, the track it draws is 2px.

    Firefox fills the played portion itself, through ::-moz-range-progress.
    WebKit has no equivalent, so the filled part is a gradient whose stop
    comes from --progress, which the script sets on the element -- custom
    properties reach pseudo-elements, and nothing else does.
  */
  .podcast-seek::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(
      to right,
      var(--color-red) var(--progress, 0%),
      rgba(255, 255, 255, 0.22) var(--progress, 0%)
    );
  }

  .podcast-seek::-moz-range-track {
    height: 2px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.22);
  }

  .podcast-seek::-moz-range-progress {
    height: 2px;
    border-radius: 1px;
    background: var(--color-red);
  }

  /*
    The handle stays out of the way until it is wanted. A dot parked on the
    top edge of every page is noise; one that appears when the pointer is near
    or the control has focus is an affordance.
  */
  .podcast-seek::-webkit-slider-thumb {
    appearance: none;
    width: 11px;
    height: 11px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--color-red);
    opacity: 0;
    transition: opacity 150ms;
  }

  .podcast-seek::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--color-red);
    opacity: 0;
    transition: opacity 150ms;
  }

  .podcast-seek:hover::-webkit-slider-thumb,
  .podcast-seek:focus-visible::-webkit-slider-thumb {
    opacity: 1;
  }

  .podcast-seek:hover::-moz-range-thumb,
  .podcast-seek:focus-visible::-moz-range-thumb {
    opacity: 1;
  }

  /* Nothing loaded yet: the line is there, but it is not a control. */
  .podcast-seek:disabled::-webkit-slider-thumb,
  .podcast-seek:disabled::-moz-range-thumb {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .podcast-seek::-webkit-slider-thumb,
    .podcast-seek::-moz-range-thumb {
      transition: none;
    }
  }
</style>
