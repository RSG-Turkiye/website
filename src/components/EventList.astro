---
/**
 * The /events page's body, shared by the English and Turkish routes.
 *
 * Both pages used to carry their own copy of the event list and their own
 * copy of this markup. Two lists meant two things to update and, in
 * practice, neither got updated.
 */
import { events, groupEvents, type CommunityEvent } from "../data/events";
import { useTranslations } from "../i18n/ui";
import YearRail from "./YearRail.astro";
import EventsAside from "./EventsAside.astro";

interface Props {
  lang: "en" | "tr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Build time. The page is rebuilt nightly, so "now" is at worst a day old --
// and the boundary this decides is midnight after an event's last day.
const now = new Date();
const { upcoming, symposiums, workshops, hackathons, meetups } = groupEvents(events, now);

const sections: { id: string; title: string; items: CommunityEvent[] }[] = [
  { id: "upcoming", title: t("events.section.upcoming"), items: upcoming },
  { id: "symposiums", title: t("events.symposiums.title"), items: symposiums },
  { id: "hackathons", title: t("events.hackathons.title"), items: hackathons },
  { id: "workshops", title: t("events.workshops.title"), items: workshops },
  { id: "meetups", title: t("events.meetups.title"), items: meetups },
];

---

<section class="bg-white py-16">
  <div class="max-w-7xl mx-auto px-6 xl:grid xl:grid-cols-[minmax(0,1fr)_17rem] xl:gap-12">
  <div>
    {/* An empty section renders a heading over nothing, which reads as a
        broken page. With no event ahead of us, "Upcoming Events" simply
        does not appear. */}
    {sections.filter((s) => s.items.length > 0).map((section) => (
      <div class="mb-12" id={section.id}>
        <h2 class="text-xl font-semibold text-navy pb-2 border-b-2 border-navy inline-block mb-6 lg:ml-[calc(var(--rail-width)+var(--rail-gap))]">
          {section.title}
        </h2>
        <YearRail events={section.items} lang={lang} now={now} compact />
      </div>
    ))}
  </div>
  <div class="mt-14 xl:mt-0"><EventsAside lang={lang} /></div>
  </div>
</section>
