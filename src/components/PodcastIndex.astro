---
/**
 * The podcast page, once, for both languages.
 *
 * One <audio> element, not one per episode. Three of them would be three
 * players a reader can start at the same time, and -- with preload -- three
 * downloads totalling 145 MB starting the moment the page opens. Clicking an
 * episode points the single player at it.
 *
 * The player is here rather than a Spotify iframe because the show publishes
 * an RSS feed with real MP3s: styling matches the site, the interface is in
 * the reader's language, and there is no third-party frame. The subscribe
 * links to Spotify, Apple and Castbox are still offered, for people who want
 * the show in the app they already use.
 *
 * Nothing plays until somebody presses play. Browsers block audio without a
 * user gesture, Spotify's embed has never supported autoplay either, and WCAG
 * 1.4.2 counts more than three seconds of automatic sound as a failure. The
 * page makes the podcast easy to find and easy to start; it does not start
 * itself.
 */
import { useTranslations } from '../i18n/ui';
import { episodes, show, formatDate, formatDuration, summarise } from '../lib/podcast';

interface Props {
  lang: 'en' | 'tr';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const platforms: [string, string][] = [
  ['Spotify', show.platforms.spotify],
  ['Apple Podcasts', show.platforms.apple],
  ['Castbox', show.platforms.castbox],
  ['RSS', show.platforms.rss],
];
---

<section class="bg-white py-10">
  <div class="max-w-4xl mx-auto px-6">

    <!-- Show header -->
    <div class="flex flex-col sm:flex-row gap-6 items-start mb-8 pb-8 border-b border-border">
      <img
        src={show.image}
        alt=""
        width="160"
        height="160"
        loading="lazy"
        class="w-32 h-32 sm:w-40 sm:h-40 rounded-lg object-cover border border-border shrink-0"
      />
      <div class="min-w-0">
        <h2 class="text-xl font-bold text-navy mb-2">{show.title}</h2>
        <p class="text-sm text-gray-600 leading-relaxed mb-4">{summarise(show.description, 340)}</p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-widest text-gray-600">{t('podcast.listenOn')}</span>
          {platforms.map(([name, href]) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-3 py-1.5 rounded border border-border text-xs font-medium text-gray-600 hover:border-navy-mid hover:text-navy transition-colors no-underline"
            >
              {name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!--
      The player. It sits above the list and stays put while the reader scrolls
      through episodes, so starting a second one does not mean hunting for the
      controls again.
    -->
    <div id="player" class="sticky top-20 z-10 mb-8 rounded-lg border border-border bg-navy-light p-4">
      <p
        id="playerLabel"
        class="text-xs font-semibold uppercase tracking-widest text-gray-600 mb-1"
        data-now-playing={t('podcast.nowPlaying')}
      >
        {t('podcast.chooseEpisode')}
      </p>
      <p id="playerTitle" class="text-sm font-semibold text-navy mb-3 leading-snug"></p>
      <!--
        preload="none": the three episodes are 145 MB between them, and a
        reader who came to read the descriptions should not pay for any of it.
        controls, rather than a hand-built transport, because the native one is
        keyboard-accessible, screen-reader-labelled and already familiar.
      -->
      <audio id="audio" class="w-full" controls preload="none"></audio>
    </div>

    <!-- Episodes -->
    <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-600 mb-4">
      {t('podcast.episodes')} <span class="font-normal normal-case tracking-normal">({episodes.length})</span>
    </h2>

    <ol class="flex flex-col gap-4 list-none p-0 m-0">
      {episodes.map((episode, index) => (
        <li class="rounded-lg border border-border bg-white p-4">
          <div class="flex items-start gap-4">
            <button
              type="button"
              class="episode-play shrink-0 w-11 h-11 rounded-full bg-red text-white flex items-center justify-center hover:bg-red-hover transition-colors cursor-pointer"
              data-audio={episode.audioUrl}
              data-title={episode.title}
              data-index={index}
              aria-label={`${t('podcast.play')}: ${episode.title}`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-3 text-xs text-gray-600 mb-1">
                <time datetime={episode.pubDate}>{formatDate(episode.pubDate, lang)}</time>
                {episode.durationSeconds > 0 && <span>{formatDuration(episode.durationSeconds, lang)}</span>}
              </div>
              <h3 class="text-base font-semibold text-navy mb-1 leading-snug">{episode.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{summarise(episode.description)}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<script>
  const audio = document.getElementById('audio') as HTMLAudioElement | null;
  const label = document.getElementById('playerLabel');
  const title = document.getElementById('playerTitle');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.episode-play'));

  if (audio && label && title) {
    const nowPlaying = label.dataset.nowPlaying ?? '';

    /**
     * A play() a browser refuses is not an error worth a console trace: it
     * happens when the tab is backgrounded or the gesture is not recognised,
     * and the visible controls already show the paused state.
     */
    const start = () => void audio.play().catch(() => {});

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const src = button.dataset.audio!;
        // Clicking the episode already loaded toggles it. Setting src again
        // would reload it and throw away where the reader had got to.
        if (audio.dataset.loaded === src) {
          if (audio.paused) start();
          else audio.pause();
          return;
        }
        audio.dataset.loaded = src;
        audio.src = src;
        title.textContent = button.dataset.title ?? '';
        label.textContent = nowPlaying;
        start();
      });
    }
  }
</script>
