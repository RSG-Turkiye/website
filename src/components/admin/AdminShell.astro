---
/**
 * Two decisions in here are load-bearing and easy to undo by accident:
 *
 * `text-gray-500`, not `gray-400`. Measured against white, gray-400 is
 * 2.54:1 -- under WCAG AA's 4.5 for body text and under even the 3.0 large-text
 * floor. gray-500 is 4.83:1. It was the panel's dominant secondary colour in 36
 * places, so lightening it back makes most of the panel unreadable to some
 * people, while looking merely "softer" to everyone else.
 *
 * `overflow-x-auto` on the table cards, not `overflow-hidden`. The cards used to
 * clip: with seven columns and a long Turkish action label ("Üyeliği kaldır"),
 * the Actions column fell outside the card and there was no scrollbar to reach
 * it -- it simply vanished. Widening the panel to max-w-7xl is what actually
 * makes it fit; this is the net for the day something grows again.
 */
// Shared markup for the admin panel, rendered by both /admin (English) and
// /tr/admin (Turkish). The two pages used to be near-clones of this file
// with every string hand-translated in place; the copy now lives in
// src/i18n/ui.ts under the `admin.*` keys, and the client-side logic lives
// in src/scripts/admin/main.ts (shared the same way).
//
// One pre-existing, non-copy difference between the two languages is
// reproduced here rather than resolved: the Turkish admin page never had
// rank/badge management (the "Rank" and "Badges" table columns), so those
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from './AdminNav.astro';
import SymposiumPane from './panes/SymposiumPane.astro';
import SocialPane from './panes/SocialPane.astro';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: 'en' | 'tr';
  pageTitle: string;
  description: string;
  homeUrl: string;
}

const { lang, pageTitle, description, homeUrl } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <div class="min-h-screen bg-[#F7F7F6] py-10 px-4">
    <div class="max-w-7xl mx-auto">

      <!-- Not authorized -->
      <div id="notAuth" class="hidden text-center py-24">
        <p class="text-gray-500" set:html={t('admin.notAuth.message')} />
        <a href={homeUrl} class="mt-4 inline-block text-sm text-navy hover:underline">{t('admin.notAuth.goHome')}</a>
      </div>

      <!-- Loading -->
      <div id="loadingState" class="flex items-center justify-center py-24">
        <div class="w-8 h-8 border-2 border-navy border-t-transparent rounded-full animate-spin"></div>
      </div>

      <!-- Admin content -->
      <div id="adminContent" class="hidden">

        <!-- Phone top bar: the menu, back to the sub-page list, and where you are -->
        <div class="lg:hidden flex items-center gap-2 mb-4">
          <button type="button" id="navToggle" aria-controls="navDrawer" aria-expanded="false" aria-label={t('admin.nav.menu')}
            class="w-11 h-11 shrink-0 inline-flex items-center justify-center rounded-xl border border-border bg-white text-navy text-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid">☰</button>
          <button type="button" id="phoneBack" aria-label={t('admin.nav.back')}
            class="hidden w-11 h-11 shrink-0 items-center justify-center rounded-xl text-navy text-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid">‹</button>
          <h1 id="phoneTitle" class="flex-1 min-w-0 truncate text-base font-semibold text-navy"></h1>
        </div>

        <!-- Toasts -->
        <div id="toastStack" class="fixed z-50 bottom-4 inset-x-4 lg:inset-x-auto lg:right-6 flex flex-col gap-2 items-stretch lg:items-end"></div>

        <div id="healthBanner" role="status" class="hidden mb-6 rounded-2xl border border-red-200 bg-red-tint px-4 py-2 text-sm text-[#8a1c1c]"></div>

        <!-- Phone drawer: shell.ts clones #sectionNav into the panel -->
        <div id="navDrawer" class="hidden fixed inset-0 z-40 bg-black/30 lg:hidden">
          <div class="w-4/5 max-w-xs h-full bg-white p-3 overflow-y-auto" data-drawer-panel></div>
        </div>

        <div class="flex flex-col lg:flex-row gap-6 items-start">
          <aside class="hidden lg:block w-60 shrink-0 bg-white rounded-2xl border border-border p-2">
            <p class="px-3 pt-2 pb-1 text-base font-bold text-navy">{t('admin.header.title')}</p>
            <AdminNav lang={lang} />
          </aside>

          <div class="flex-1 min-w-0 w-full">
            <h1 id="sectionTitle" class="hidden lg:block text-2xl font-bold text-navy mb-4"></h1>
            <div id="subNav"></div>

        <section data-section="genel"><div id="overview"></div></section>

        <section id="userManagementSection" data-section="kullanicilar">
        <div data-sub="liste">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.members.heading')}</h2>
          <div class="lg:grid lg:grid-cols-[1fr_22rem] gap-4 items-start">
            <div id="usersPane" class="min-w-0">
              <div class="bg-white rounded-2xl border border-border p-4 mb-4 flex flex-col gap-3">
                <input
                  id="searchInput"
                  type="search"
                  placeholder={t('admin.search.placeholder')}
                  class="w-full min-h-11 lg:min-h-9 px-4 py-2 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid transition-colors"
                />
                <div class="flex flex-wrap gap-2">
                  <button type="button" data-filter="all" class="filter-btn active-filter min-h-11 lg:min-h-9 px-4 rounded-xl text-sm font-medium transition-colors">{t('admin.filter.all')}</button>
                  <button type="button" data-filter="members" class="filter-btn min-h-11 lg:min-h-9 px-4 rounded-xl text-sm font-medium transition-colors">{t('admin.filter.members')}</button>
                  <button type="button" data-filter="pending" class="filter-btn min-h-11 lg:min-h-9 px-4 rounded-xl text-sm font-medium transition-colors">{t('admin.filter.pending')}</button>
                  <button type="button" data-filter="roles" class="filter-btn min-h-11 lg:min-h-9 px-4 rounded-xl text-sm font-medium transition-colors">{t('admin.users.filter.roles')}</button>
                </div>
              </div>
              <div id="usersList" class="flex flex-col gap-2"></div>
              <div id="emptyState" class="hidden text-center py-12 text-sm text-gray-500">{t('admin.table.noUsersFound')}</div>
            </div>
            <div id="userDetail" class="hidden lg:block min-w-0 bg-white rounded-2xl border border-border p-4 lg:sticky lg:top-4"></div>
          </div>
        </div>
        <div data-sub="yetkiler"><div id="rolesView"></div></div>
        </section>

        <!-- Announcements section -->
        <section id="announcementsSection" data-section="duyurular">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.announcements.heading')}</h2>

          <div class="bg-white rounded-2xl border border-border p-4 mb-6">
            <form id="announcementForm" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="hidden" id="announcementEditId" value="" />
              <input id="annTitle" type="text" placeholder={t('admin.announcements.form.titlePlaceholder')} required maxlength="80"
                class="px-3 py-2 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid sm:col-span-2" />
              <textarea id="annDescription" placeholder={t('admin.announcements.form.descriptionPlaceholder')} required rows="2" maxlength="200"
                class="px-3 py-2 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid sm:col-span-2"></textarea>
              <input id="annButtonText" type="text" placeholder={t('admin.announcements.form.buttonTextPlaceholder')} required maxlength="30"
                class="px-3 py-2 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
              <input id="annButtonUrl" type="url" placeholder={t('admin.announcements.form.buttonUrlPlaceholder')} required
                class="px-3 py-2 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
              <label class="flex items-center gap-2 text-sm text-gray-600">
                {t('admin.announcements.form.expiresOn')}
                <input id="annExpiresAt" type="date" required
                  class="px-3 py-2 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
              </label>
              <label class="flex items-center gap-2 text-sm text-gray-600">
                {t('admin.announcements.form.site')}
                <!-- The column has been read by two endpoints since it was
                     added and written by nothing, so every announcement was a
                     main-site one and the symposium list was empty by
                     construction. -->
                <select id="annSite"
                  class="px-3 py-2 rounded-xl border border-border text-sm text-navy bg-white focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid">
                  <option value="main">{t('admin.announcements.form.siteMain')}</option>
                  <option value="symposium">{t('admin.announcements.form.siteSymposium')}</option>
                </select>
              </label>
              <label class="flex items-center gap-2 min-h-11 lg:min-h-0 text-sm text-gray-600">
                <input id="annShowAsPopup" type="checkbox" class="rounded border-border" />
                {t('admin.announcements.form.showAsPopup')}
              </label>
              <div class="sm:col-span-2 flex items-center gap-2">
                <button type="submit" class="inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid bg-navy text-white hover:bg-navy-mid">
                  {t('admin.announcements.form.save')}
                </button>
                <button type="button" id="cancelEditBtn" class="hidden inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">
                  {t('admin.announcements.form.cancelEdit')}
                </button>
              </div>
            </form>
          </div>

          <div id="announcementsList" class="flex flex-col gap-2"></div>
          <p id="announcementsEmptyState" class="hidden text-center py-12 text-sm text-gray-500">{t('admin.announcements.table.noneYet')}</p>
        </section>

        <!-- Blog submissions section -->
        <section id="blogSubmissionsSection" data-section="blog">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.blog.heading')}</h2>
          <div id="blogSubmissionsList" class="flex flex-col gap-4"></div>
          <p id="blogSubmissionsEmpty" class="hidden text-sm text-gray-500">{t('admin.blog.empty')}</p>
        </section>

        <SymposiumPane lang={lang} />
        <SocialPane lang={lang} />

        <!-- Send as RSG -->
        <section id="rsgMailSection" data-section="eposta">

          <div data-sub="yetki">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.mail.bulkGrant.heading')}</h2><div class="bg-white rounded-2xl border border-border p-6 mb-4">
            <form id="bulkGrantForm" class="flex flex-col gap-3">
              <textarea id="bulkEmails" rows="4" required
                placeholder={t('admin.mail.bulkGrant.emailsPlaceholder')}
                class="px-3 py-2 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid"></textarea>
              <div class="flex items-center gap-3">
                <input id="bulkTeam" type="text" placeholder={t('admin.mail.bulkGrant.teamPlaceholder')}
                  class="flex-1 px-3 py-2 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
                <button type="submit" class="inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid bg-navy text-white hover:bg-navy-mid">{t('admin.mail.bulkGrant.submit')}</button>
              </div>
              <p id="bulkResult" class="hidden text-xs"></p>
            </form>
          </div></div>

          <div data-sub="gondericiler">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.mail.senders.heading')}</h2><div class="bg-white rounded-2xl border border-border p-6 mb-4">
            <div id="sendersList" class="flex flex-col gap-2"></div>
            <p id="sendersEmpty" class="hidden text-sm text-gray-500">{t('admin.mail.senders.empty')}</p>
          </div></div>

          <div data-sub="ekler">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.mail.attachments.heading')}</h2><div class="bg-white rounded-2xl border border-border p-6 mb-4">

            <input id="attachmentFile" type="file" accept=".pdf,.jpg,.jpeg,.png,.docx,.pptx"
              class="text-sm text-gray-500 block" />
            <p class="text-xs text-gray-500 mt-1">{t('admin.mail.attachments.typesNote')}</p>

            <div id="attachmentChosen" class="hidden mt-3 text-sm text-navy bg-[#F7F7F6] rounded-xl px-3 py-2"></div>
            <p id="attachmentError" class="hidden mt-2 text-sm text-red-600"></p>

            <button type="button" id="attachmentUploadBtn" disabled
              class="mt-3 inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid bg-navy text-white hover:bg-navy-mid">
              {t('admin.mail.attachments.uploadBtn')}
            </button>

            <div id="attachmentAdminList" class="flex flex-col gap-2 mt-4"></div>
            <p id="attachmentsEmpty" class="hidden text-sm text-gray-500 mt-2">{t('admin.mail.attachments.empty')}</p>
          </div></div>

          <div data-sub="gonderilenler">
          <h2 class="text-lg font-semibold text-navy mb-4">{t('admin.mail.allSends.heading')}</h2><div class="bg-white rounded-2xl border border-border p-6">
            <div id="allSendsList" class="flex flex-col gap-2"></div>
            <p id="allSendsEmpty" class="hidden text-sm text-gray-500">{t('admin.mail.allSends.empty')}</p>
          </div>
          </div>
        </section>

        <section data-section="baglantilar">
          <h2 class="text-lg font-semibold text-navy mb-1">{t('admin.connections.heading')}</h2>
          <p class="text-sm text-gray-500 mb-4">{t('admin.connections.intro')}</p>
          <div id="connectionsBody" class="flex flex-col gap-2"></div>
        </section>

        <section data-section="kayit">
          <h2 class="text-lg font-semibold text-navy mb-1">{t('admin.audit.heading')}</h2>
          <p class="text-sm text-gray-500 mb-4">{t('admin.audit.intro')}</p>
          <form id="auditFilter" class="bg-white rounded-2xl border border-border p-4 mb-4 flex flex-wrap items-end gap-3">
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.user')}<input id="auditUser" type="text" class="block mt-1 w-full px-3 py-2 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.action')}<input id="auditAction" type="text" class="block mt-1 w-full px-3 py-2 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.from')}<input id="auditFrom" type="date" class="block mt-1 w-full px-3 py-2 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.to')}<input id="auditTo" type="date" class="block mt-1 w-full px-3 py-2 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <div class="w-full flex flex-wrap gap-2">
            <button type="submit" class="inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid bg-navy text-white hover:bg-navy-mid">{t('admin.audit.apply')}</button>
            <span class="flex-1"></span>
            <button type="button" id="auditExportCsv" class="inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.exportCsv')}</button>
            <button type="button" id="auditExportJson" class="inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.exportJson')}</button>
            <button type="button" id="auditVerify" class="inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.verify')}</button>
            </div>
          </form>
          <p id="auditVerifyResult" class="text-sm"></p>
          <div id="auditBody" class="flex flex-col gap-2 mt-2"></div>
          <button type="button" id="auditMore" class="hidden mt-3 inline-flex items-center justify-center gap-1 px-4 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.more')}</button>
        </section>

          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .filter-btn {
    @apply bg-[#F7F7F6] text-gray-500 hover:bg-navy-light hover:text-navy;
  }
  .active-filter {
    @apply bg-navy text-white hover:bg-navy;
  }
</style>

<script>
  import '../../scripts/admin/main';
</script>
