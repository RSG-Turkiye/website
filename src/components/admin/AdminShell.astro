---
/**
 * Two decisions in here are load-bearing and easy to undo by accident:
 *
 * `text-gray-500`, not `gray-400`. Measured against white, gray-400 is
 * 2.54:1 -- under WCAG AA's 4.5 for body text and under even the 3.0 large-text
 * floor. gray-500 is 4.83:1. It was the panel's dominant secondary colour in 36
 * places, so lightening it back makes most of the panel unreadable to some
 * people, while looking merely "softer" to everyone else.
 *
 * Lists are rows (src/scripts/admin/ui-kit.ts), never tables, so nothing
 * needs to scroll sideways: no element may be wider than the viewport at
 * 390 or 1280 px (tests/browser/admin-overflow.mjs checks every route).
 *
 * From lg up the panel is exactly one window tall (BaseLayout fitViewport) and
 * the page never scrolls: #sectionBody scrolls the section shown, and the
 * sections with a side panel (users, inbox, social calendar) fill it with
 * lg:h-full and scroll per column. Phones keep the page scroll. The title and
 * the sub-page tabs sit outside #sectionBody, so they never scroll; a pane's
 * own heading that only repeats the tab label is lg:sr-only.
 *
 * From lg up the content is set like a desktop tool: #sectionBody is text-sm,
 * and cards, rows, fields and buttons take tighter lg: paddings (the shared
 * ones live in ui-kit.ts). Phones keep today's sizes and 44 px targets.
 * tests/browser/admin-fit-viewport.mjs checks every route.
 */
// Shared markup for the admin panel, rendered by both /admin (English) and
// /tr/admin (Turkish). The two pages used to be near-clones of this file
// with every string hand-translated in place; the copy now lives in
// src/i18n/ui.ts under the `admin.*` keys, and the client-side logic lives
// in src/scripts/admin/main.ts (shared the same way). Both languages render
// the same panel, rank and badge management included.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from './AdminNav.astro';
import SymposiumPane from './panes/SymposiumPane.astro';
import SocialPane from './panes/SocialPane.astro';
import MailPane from './panes/MailPane.astro';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: 'en' | 'tr';
  pageTitle: string;
  description: string;
  homeUrl: string;
}

const { lang, pageTitle, description, homeUrl } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout pageTitle={pageTitle} description={description} fitViewport>
  <div class="min-h-screen bg-[#F7F7F6] py-10 px-4 lg:min-h-0 lg:flex-1 lg:py-4 lg:flex lg:flex-col">
    <div class="max-w-7xl mx-auto lg:w-full lg:flex-1 lg:min-h-0 lg:flex lg:flex-col">

      <!-- Not authorized -->
      <div id="notAuth" class="hidden text-center py-24">
        <p class="text-gray-500" set:html={t('admin.notAuth.message')} />
        <a href={homeUrl} class="mt-4 inline-block text-sm text-navy hover:underline">{t('admin.notAuth.goHome')}</a>
      </div>

      <!-- Signed out: the site's sign-in page (it returns to /account afterwards) -->
      <div id="notSignedIn" class="hidden text-center py-24">
        <p class="text-gray-500 mb-4">{t('admin.notSignedIn.message')}</p>
        <a href={lang === 'tr' ? '/tr/login/' : '/login/'} class="inline-flex px-6 py-2.5 min-h-11 items-center rounded-xl bg-navy text-white text-sm font-semibold no-underline hover:bg-navy-mid transition-colors">{t('admin.notSignedIn.signIn')}</a>
      </div>

      <!-- Loading -->
      <div id="loadingState" class="flex items-center justify-center py-24">
        <div class="w-8 h-8 border-2 border-navy border-t-transparent rounded-full animate-spin"></div>
      </div>

      <!-- Admin content -->
      <div id="adminContent" class="hidden fit-col lg:flex-1">

        <!-- Phone top bar: the menu, back to the sub-page list, and where you are -->
        <div class="lg:hidden flex items-center gap-2 mb-4">
          <button type="button" id="navToggle" aria-controls="navDrawer" aria-expanded="false" aria-label={t('admin.nav.menu')}
            class="w-11 h-11 shrink-0 inline-flex items-center justify-center rounded-xl border border-border bg-white text-navy text-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid">☰</button>
          <button type="button" id="phoneBack" aria-label={t('admin.nav.back')}
            class="hidden w-11 h-11 shrink-0 items-center justify-center rounded-xl text-navy text-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid">‹</button>
          <h1 id="phoneTitle" class="flex-1 min-w-0 truncate text-base font-semibold text-navy"></h1>
        </div>

        <!-- Toasts -->
        <div id="toastStack" class="fixed z-50 bottom-4 inset-x-4 lg:inset-x-auto lg:right-6 flex flex-col gap-2 items-stretch lg:items-end"></div>

        <div id="healthBanner" role="status" class="hidden shrink-0 mb-6 rounded-2xl border border-red-200 bg-red-tint px-4 py-2 text-sm text-[#8a1c1c]"></div>

        <!-- Phone drawer: shell.ts clones #sectionNav into the panel -->
        <div id="navDrawer" class="hidden fixed inset-0 z-40 bg-black/30 lg:hidden">
          <div class="w-4/5 max-w-xs h-full bg-white p-3 overflow-y-auto" data-drawer-panel></div>
        </div>

        <div class="flex flex-col lg:flex-row gap-6 lg:gap-4 items-start lg:flex-1 lg:min-h-0">
          <aside class="hidden lg:block w-56 shrink-0 bg-white rounded-2xl border border-border p-2 lg:max-h-full lg:overflow-y-auto lg:overscroll-contain">
            <p class="px-3 pt-1.5 pb-1 text-sm font-bold text-navy">{t('admin.header.title')}</p>
            <AdminNav lang={lang} />
          </aside>

          <div class="flex-1 min-w-0 w-full lg:self-stretch lg:flex lg:flex-col lg:min-h-0">
            <h1 id="sectionTitle" class="hidden lg:block shrink-0 text-xl font-bold text-navy mb-2"></h1>
            <div id="subNav" class="shrink-0"></div>

            <!-- From lg up the one scroll box for the section shown; a section
                 with a side panel fills it exactly (lg:h-full) and scrolls
                 per column instead. p-1/-m-1 leaves room for focus rings. -->
            <div id="sectionBody" class="lg:text-sm lg:flex-1 lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:p-1 lg:-m-1">

        <section data-section="genel"><div id="overview"></div></section>

        <section id="userManagementSection" data-section="kullanicilar" class="lg:h-full">
        <div data-sub="liste" class="lg:h-full fit-col">
          <h2 class="text-lg font-semibold text-navy mb-4 lg:sr-only">{t('admin.members.heading')}</h2>
          <div class="lg:grid lg:grid-cols-[1fr_22rem] lg:grid-rows-[minmax(0,1fr)] lg:flex-1 lg:min-h-0 gap-4 lg:gap-3 items-start">
            <div id="usersPane" class="min-w-0 lg:h-full">
              <div class="lg:h-full lg:flex lg:flex-col">
              <div class="shrink-0 bg-white rounded-2xl border border-border p-4 lg:p-3 mb-4 lg:mb-3 flex flex-col gap-3 lg:gap-2">
                <input
                  id="searchInput"
                  type="search"
                  placeholder={t('admin.search.placeholder')}
                  class="w-full min-h-11 lg:min-h-9 px-4 py-2 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid transition-colors"
                />
                <div class="flex flex-wrap gap-2">
                  <button type="button" data-filter="all" class="filter-btn active-filter min-h-11 lg:min-h-9 px-4 lg:px-3 rounded-xl text-sm font-medium transition-colors">{t('admin.filter.all')}</button>
                  <button type="button" data-filter="members" class="filter-btn min-h-11 lg:min-h-9 px-4 lg:px-3 rounded-xl text-sm font-medium transition-colors">{t('admin.filter.members')}</button>
                  <button type="button" data-filter="pending" class="filter-btn min-h-11 lg:min-h-9 px-4 lg:px-3 rounded-xl text-sm font-medium transition-colors">{t('admin.filter.pending')}</button>
                  <button type="button" data-filter="roles" class="filter-btn min-h-11 lg:min-h-9 px-4 lg:px-3 rounded-xl text-sm font-medium transition-colors">{t('admin.users.filter.roles')}</button>
                </div>
              </div>
              <div id="emptyState" class="hidden text-center py-12 lg:py-6 text-sm text-gray-500">{t('admin.table.noUsersFound')}</div>
              <div id="usersList" class="flex flex-col gap-2 lg:flex-1 lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:p-1 lg:-m-1"></div>
              </div>
            </div>
            <div id="userDetail" class="hidden lg:block min-w-0 bg-white rounded-2xl border border-border p-4 lg:p-3 lg:max-h-full lg:overflow-y-auto lg:overscroll-contain"></div>
          </div>
        </div>
        <div data-sub="yetkiler"><div id="rolesView"></div></div>
        </section>

        <!-- Announcements section -->
        <section id="announcementsSection" data-section="duyurular">
          <h2 class="text-lg font-semibold text-navy mb-4 lg:sr-only">{t('admin.announcements.heading')}</h2>

          <div class="bg-white rounded-2xl border border-border p-4 lg:p-3 mb-6 lg:mb-4">
            <form id="announcementForm" class="grid grid-cols-1 sm:grid-cols-2 gap-3 lg:gap-2">
              <input type="hidden" id="announcementEditId" value="" />
              <input id="annTitle" type="text" placeholder={t('admin.announcements.form.titlePlaceholder')} required maxlength="80"
                class="px-3 py-2 lg:py-1.5 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid sm:col-span-2" />
              <textarea id="annDescription" placeholder={t('admin.announcements.form.descriptionPlaceholder')} required rows="2" maxlength="200"
                class="px-3 py-2 lg:py-1.5 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid sm:col-span-2"></textarea>
              <input id="annButtonText" type="text" placeholder={t('admin.announcements.form.buttonTextPlaceholder')} required maxlength="30"
                class="px-3 py-2 lg:py-1.5 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
              <input id="annButtonUrl" type="url" placeholder={t('admin.announcements.form.buttonUrlPlaceholder')} required
                class="px-3 py-2 lg:py-1.5 rounded-xl border border-border text-sm text-navy placeholder-gray-500 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
              <label class="flex items-center gap-2 text-sm text-gray-600">
                {t('admin.announcements.form.expiresOn')}
                <input id="annExpiresAt" type="date" required
                  class="px-3 py-2 lg:py-1.5 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" />
              </label>
              <label class="flex items-center gap-2 text-sm text-gray-600">
                {t('admin.announcements.form.site')}
                <!-- The column has been read by two endpoints since it was
                     added and written by nothing, so every announcement was a
                     main-site one and the symposium list was empty by
                     construction. -->
                <select id="annSite"
                  class="px-3 py-2 lg:py-1.5 rounded-xl border border-border text-sm text-navy bg-white focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid">
                  <option value="main">{t('admin.announcements.form.siteMain')}</option>
                  <option value="symposium">{t('admin.announcements.form.siteSymposium')}</option>
                </select>
              </label>
              <label class="flex items-center gap-2 min-h-11 lg:min-h-0 text-sm text-gray-600">
                <input id="annShowAsPopup" type="checkbox" class="rounded border-border" />
                {t('admin.announcements.form.showAsPopup')}
              </label>
              <div class="sm:col-span-2 flex items-center gap-2">
                <button type="submit" class="inline-flex items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid bg-navy text-white hover:bg-navy-mid">
                  {t('admin.announcements.form.save')}
                </button>
                <button type="button" id="cancelEditBtn" class="hidden items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">
                  {t('admin.announcements.form.cancelEdit')}
                </button>
              </div>
            </form>
          </div>

          <div id="announcementsList" class="flex flex-col gap-2"></div>
          <p id="announcementsEmptyState" class="hidden text-center py-12 lg:py-6 text-sm text-gray-500">{t('admin.announcements.table.noneYet')}</p>
        </section>

        <!-- Blog submissions section -->
        <section id="blogSubmissionsSection" data-section="blog">
          <h2 class="text-lg font-semibold text-navy mb-4 lg:sr-only">{t('admin.blog.heading')}</h2>
          <div id="blogSubmissionsList" class="flex flex-col gap-4"></div>
          <p id="blogSubmissionsEmpty" class="hidden text-sm text-gray-500">{t('admin.blog.empty')}</p>
        </section>

        <SymposiumPane lang={lang} />
        <SocialPane lang={lang} />

        <MailPane lang={lang} />

        <section data-section="baglantilar">
          <h2 class="text-lg font-semibold text-navy mb-1 lg:sr-only">{t('admin.connections.heading')}</h2>
          <p class="text-sm text-gray-500 mb-4 lg:mb-3">{t('admin.connections.intro')}</p>
          <div id="connectionsBody" class="flex flex-col gap-2"></div>
        </section>

        <section data-section="kayit">
          <h2 class="text-lg font-semibold text-navy mb-1 lg:sr-only">{t('admin.audit.heading')}</h2>
          <p class="text-sm text-gray-500 mb-4 lg:mb-3">{t('admin.audit.intro')}</p>
          <form id="auditFilter" class="bg-white rounded-2xl border border-border p-4 lg:p-3 mb-4 lg:mb-3 flex flex-wrap items-end gap-3 lg:gap-2">
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.user')}<input id="auditUser" type="text" class="block mt-1 w-full px-3 py-2 lg:py-1.5 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.action')}<input id="auditAction" type="text" class="block mt-1 w-full px-3 py-2 lg:py-1.5 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.from')}<input id="auditFrom" type="date" class="block mt-1 w-full px-3 py-2 lg:py-1.5 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <label class="text-sm text-gray-600 min-w-0 flex-1 basis-40">{t('admin.audit.filter.to')}<input id="auditTo" type="date" class="block mt-1 w-full px-3 py-2 lg:py-1.5 min-h-11 lg:min-h-9 rounded-xl border border-border text-sm text-navy focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid focus:border-navy-mid" /></label>
            <div class="w-full flex flex-wrap gap-2">
            <button type="submit" class="inline-flex items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid bg-navy text-white hover:bg-navy-mid">{t('admin.audit.apply')}</button>
            <span class="flex-1"></span>
            <button type="button" id="auditExportCsv" class="inline-flex items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.exportCsv')}</button>
            <button type="button" id="auditExportJson" class="inline-flex items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.exportJson')}</button>
            <button type="button" id="auditVerify" class="inline-flex items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.verify')}</button>
            </div>
          </form>
          <p id="auditVerifyResult" class="text-sm"></p>
          <div id="auditBody" class="flex flex-col gap-2 mt-2"></div>
          <button type="button" id="auditMore" class="hidden mt-3 items-center justify-center gap-1 px-4 lg:px-3 min-h-11 lg:min-h-9 rounded-xl text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid border border-navy text-navy hover:bg-navy-light">{t('admin.audit.more')}</button>
        </section>

            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* A flex column from lg up, but only while shown: on an element whose
     `hidden` class is toggled, a display utility would beat `.hidden` in the
     built CSS and show it anyway. */
  @media (width >= 64rem) {
    .fit-col:not(.hidden) { display: flex; flex-direction: column; min-height: 0; }
  }
</style>

<style>
  @reference "../../styles/global.css";

  .filter-btn {
    @apply bg-[#F7F7F6] text-gray-500 hover:bg-navy-light hover:text-navy;
  }
  .active-filter {
    @apply bg-navy text-white hover:bg-navy;
  }
</style>

<script>
  import '../../scripts/admin/main';
</script>
