---
/**
 * A YouTube recording that loads only when someone plays it.
 *
 * Every webinar page embedded the full YouTube player on load: about a
 * megabyte of script and several connections, before the reader had decided
 * to watch, on 49 pages. This shows the video's thumbnail and a play button
 * instead, and swaps in the player (autoplaying, from youtube-nocookie.com,
 * so no YouTube cookie is set until then) on the first click.
 *
 * It is a link to the video, so without JavaScript it still works: it opens
 * the recording on YouTube. The VideoObject structured data on the page is
 * unaffected, so search still sees the video.
 */
interface Props {
  videoId: string;
  title: string;
  lang?: 'en' | 'tr';
}
const { videoId, title, lang = 'en' } = Astro.props;
const playLabel = lang === 'tr' ? `Videoyu oynat: ${title}` : `Play video: ${title}`;
---

<a
  href={`https://www.youtube.com/watch?v=${videoId}`}
  class="yt-facade group relative block overflow-hidden rounded-lg bg-black no-underline"
  style="aspect-ratio:16/9;"
  data-video-id={videoId}
  data-title={title}
  aria-label={playLabel}
>
  <img
    src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
    alt=""
    width="480"
    height="360"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
  />
  <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
    <svg width="68" height="48" viewBox="0 0 68 48" class="drop-shadow-lg">
      <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00"/>
      <path d="M45 24 27 14v20z" fill="#fff"/>
    </svg>
  </span>
</a>

<script>
  // Attached rather than inline: public/_headers explains why the site keeps
  // no inline handlers.
  document.querySelectorAll<HTMLAnchorElement>('a.yt-facade').forEach((link) => {
    link.addEventListener('click', (event) => {
      // Let a modified click (new tab, new window) go to YouTube as a link would.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.videoId}?autoplay=1`;
      iframe.title = link.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'h-full w-full rounded-lg border-0';
      iframe.style.aspectRatio = '16/9';
      link.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
