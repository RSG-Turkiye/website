---
import { hasHappened } from "../lib/editions";
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations, getLangFromUrl } from "../i18n/ui";
import { getCurrentEdition } from "../lib/editions-content";
import { getCurrentContent } from "../lib/content";
import CommitteeGrid from "../components/CommitteeGrid.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { state } = await getCurrentEdition();
const content = await getCurrentContent();
---

<BaseLayout
  pageTitle={t("committee.title")}
>
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("committee.title")}</h1>
      <p class="text-white/70 text-lg">{t("committee.subtitle")}</p>
    </div>
  </section>

  <CommitteeGrid lang={lang} members={content?.committee ?? []} finished={hasHappened(state)} />
</BaseLayout>
