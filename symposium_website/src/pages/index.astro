---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SponsorLogo from "../components/SponsorLogo.astro";
import EditionCta from "../components/EditionCta.astro";
import EventJsonLd from "../components/EventJsonLd.astro";
import { useTranslations, useFormat, getLangFromUrl } from "../i18n/ui";
import { getSponsorsForOrLatest } from "../data/sponsors";
import { getCurrentEdition, getPastEditions } from "../lib/editions-content";
import { locationFor, titleFor, subtitleFor, symposiumsHeld , nextEditionHint, ordinalLabel } from "../lib/editions";
import { getCurrentContent, withOverlayContent } from "../lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tf = useFormat(lang);
const held = symposiumsHeld((await getCollection("editions")).map((e) => e.data), new Date());
const prefix = lang === "tr" ? "/tr" : "";


// Recent editions for the teaser strip
const recentEditions = (await getPastEditions()).slice(0, 3);

const { state, entry: upcoming } = await getCurrentEdition();
const upcomingContent = await getCurrentContent();
// "over" for the parts that must not survive the event -- the countdown, the
// calls to action, the registration offer in the structured data.
const over = state === "finished" || state === "just-held";
const finished = over;
// The week after is when people look for the talks, so the edition stays the
// headline rather than becoming an archive entry overnight.
const justHeld = state === "just-held";
const nextUp = nextEditionHint((await getCollection("editions")).map((e) => e.data), new Date());

// Whichever edition is in play, falling back to the last one that had any.
const latestSponsors = getSponsorsForOrLatest(upcoming?.data.year ?? new Date().getFullYear());
const effectiveEdition = upcoming ? withOverlayContent(upcoming.data, upcomingContent) : null;
const heading = upcoming ? titleFor(upcoming.data, lang) : "";
const theme = upcoming ? subtitleFor(upcoming.data, lang) : "";
const place = effectiveEdition ? locationFor(effectiveEdition) : { kind: "hidden" as const };
const startsAt = upcoming?.data.startDate?.toISOString() ?? "";

const BANNER =
  "https://res.cloudinary.com/dyuf14ra5/image/upload/f_auto,q_auto,c_limit,w_1600/v1774606559/rsgturkey/symposium/2021/05/RSG_symposium_banner-scaled.jpg";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  pageTitle={t("nav.home")}
  image={BANNER}
>
  {effectiveEdition && <EventJsonLd edition={effectiveEdition} url={canonical} lang={lang} finished={finished} />}
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="relative bg-navy text-white overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${BANNER}')`}></div>
    <div class="absolute inset-0 bg-navy/75"></div>

    <div class="relative max-w-2xl mx-auto px-6 py-24 flex flex-col items-center text-center gap-4 w-full">
      <img src="/logo/rsgturkey_logo_white.png" alt="RSG-Türkiye" class="h-14 w-auto mb-2" />

      {upcoming ? (
        <Fragment>
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight">{heading}</h1>
          {theme && <p class="text-lg text-white/80 leading-relaxed">{theme}</p>}
          <p class="text-white/90 font-medium">
            {upcoming.data.startDate?.toLocaleDateString(lang === "tr" ? "tr-TR" : "en-GB", {
              day: "numeric", month: "long", year: "numeric",
            })}
            {place.kind === "full" && ` · ${place.venue}, ${place.city}`}
            {place.kind === "withheld" && ` · ${place.city} · ${t("venue.tba")}`}
            {place.kind === "city-only" && ` · ${place.city}`}
          </p>
          {!over && (
            <p
              id="countdown"
              class="text-white/60 text-sm tabular-nums"
              data-starts-at={startsAt}
              data-days-label={t("hero.countdown.days")}
            ></p>
          )}
          {over ? (
            <Fragment>
              <p class="text-white/80 text-sm">{t("edition.finished.thanks")}</p>
              {effectiveEdition?.recordingsUrl && (
                <a
                  href={effectiveEdition.recordingsUrl}
                  class="mt-1 px-6 py-3 rounded-lg bg-white text-navy font-semibold text-sm hover:bg-white/90 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  {t("edition.recordings")}
                </a>
              )}
              {!justHeld && nextUp && (
                <p class="text-white/70 text-sm">
                  {nextUp.expired
                    ? nextUp.ordinal
                      ? tf("edition.next.tba", { ordinal: ordinalLabel(nextUp.ordinal, lang) })
                      : t("edition.next.tba.unknown")
                    : nextUp.ordinal
                      ? tf("edition.next.known", {
                          ordinal: ordinalLabel(nextUp.ordinal, lang),
                          year: nextUp.year,
                          season: t(`season.${nextUp.season}`),
                        })
                      : tf("edition.next.unknown", {
                          year: nextUp.year,
                          season: t(`season.${nextUp.season}`),
                        })}
                </p>
              )}
            </Fragment>
          ) : (
            <EditionCta edition={effectiveEdition!} lang={lang} />
          )}
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight">{t("hero.tagline")}</h1>
          <p class="text-lg text-white/80 leading-relaxed">{t("hero.subtitle")}</p>
          <a href={`${prefix}/editions`} class="mt-2 px-6 py-3 rounded-lg border border-white/30 text-white font-semibold hover:bg-white/10 transition-colors text-sm">
            {t("nav.editions")}
          </a>
        </Fragment>
      )}
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────────────── -->
  <section id="about" class="max-w-7xl mx-auto px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-navy mb-4">{t("home.about.title")}</h2>
      <p class="text-gray-600 leading-relaxed text-lg">{t("home.about.body")}</p>

      <div class="mt-10 grid sm:grid-cols-3 gap-4">
        {
          [
            { label: lang === "tr" ? "Kuruluş Yılı" : "Since", value: "2012" },
            { label: lang === "tr" ? "Edisyon" : "Editions", value: String(held) },
            { label: lang === "tr" ? "Üye Ağı" : "Network", value: "ISCB SC" },
          ].map(({ label, value }) => (
            <div class="bg-navy-light rounded-xl p-5 text-center">
              <p class="text-3xl font-bold text-navy">{value}</p>
              <p class="text-sm text-gray-500 mt-1">{label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Recent Editions teaser ─────────────────────────────────── -->
  <section id="editions" class="bg-navy-light py-20 scroll-mt-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-navy">{t("nav.editions")}</h2>
        <a href={`${prefix}/editions`} class="text-sm text-navy-mid hover:text-navy transition-colors font-medium">
          {lang === "tr" ? "Tümünü gör →" : "View all →"}
        </a>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {
          recentEditions.map((edition) => (
            <a
              href={`${prefix}/editions/${edition.data.year}`}
              class="group bg-white rounded-xl border border-border overflow-hidden flex flex-col hover:shadow-lg transition-shadow"
            >
              {edition.data.posterImage && (
                <div class="aspect-video overflow-hidden bg-navy-light">
                  <img
                    src={edition.data.posterImage}
                    alt={edition.data.title}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-4 flex flex-col gap-1.5 flex-1">
                <span class="bg-navy text-white text-xs font-bold px-2 py-0.5 rounded w-fit">
                  {edition.data.year}
                </span>
                <h3 class="font-semibold text-navy text-sm leading-snug">{edition.data.title}</h3>
                {(() => {
                  const loc = locationFor(edition.data);
                  return (
                    loc.kind !== "hidden" && (
                      <p class="text-xs text-gray-400">📍 {loc.city}</p>
                    )
                  );
                })()}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Sponsors ───────────────────────────────────────────────── -->
  <section id="sponsors" class="max-w-7xl mx-auto px-6 py-20 scroll-mt-16">
    <h2 class="text-2xl font-bold text-navy text-center mb-8">{t("home.sponsors.title")}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
      {latestSponsors.map((sp) => <SponsorLogo sponsor={sp} />)}
    </div>
    <div class="text-center mt-8">
      <a href={`${prefix}/sponsors`} class="text-sm text-navy-mid hover:text-navy transition-colors font-medium">
        {lang === "tr" ? "Tüm sponsorları gör →" : "View all sponsors →"}
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const el = document.getElementById("countdown");
  const startsAt = el?.dataset.startsAt;
  const daysLabel = el?.dataset.daysLabel ?? "";
  if (el && startsAt) {
    const target = new Date(startsAt).getTime();
    const tick = () => {
      const days = Math.ceil((target - Date.now()) / 86_400_000);
      el.textContent = days > 0 ? `${days} ${daysLabel}` : "";
    };
    tick();
    setInterval(tick, 60_000);
  }
</script>
