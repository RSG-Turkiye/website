---
import BaseLayout from "../layouts/BaseLayout.astro";
import SessionRow from "../components/SessionRow.astro";
import { useTranslations, getLangFromUrl } from "../i18n/ui";
import { getCurrentContent, withOverlayContent } from "../lib/content";
import { getCurrentEdition } from "../lib/editions-content";
import { locationFor, titleFor, dateFor } from "../lib/editions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { state, entry: edition } = await getCurrentEdition();
const content = await getCurrentContent();
// Two different things to say: the week after it happened, and afterwards.
const justHeld = state === "just-held";
const finished = state === "finished" || justHeld;
const effectiveEdition = edition ? withOverlayContent(edition.data, content) : null;
const sessions = content?.sessions ?? [];
const scheduleSpeakers = content?.speakers ?? [];
---

<BaseLayout
  pageTitle={t("schedule.title")}
>
  <!-- Page header -->
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("schedule.title")}</h1>
      <p class="text-white/70 text-lg">{t("schedule.subtitle")}</p>
    </div>
  </section>

  <!-- Schedule -->
  <div class="max-w-3xl mx-auto px-6 py-12">
    {
      edition && sessions.length > 0 ? (
        <Fragment>
          <div class="bg-white rounded-xl border border-border overflow-hidden">
            <!-- Header -->
            <div class="bg-navy-light px-6 py-4 border-b border-border">
              <div class="flex items-center justify-between">
                <h2 class="font-semibold text-navy">
                  {titleFor(edition.data, lang)}
                  {finished && (
                    <span class="ml-2 align-middle bg-navy-light text-navy text-xs font-semibold px-2 py-0.5 rounded">
                      {justHeld ? t("edition.justheld.badge") : t("edition.finished.badge")}
                    </span>
                  )}
                </h2>
                <span class="text-sm text-gray-500">{dateFor(edition.data, lang)}</span>
              </div>
              {(() => {
                const loc = locationFor(effectiveEdition!);
                return (
                  <>
                    {loc.kind === "full" && (
                      <p class="text-sm text-gray-500 mt-1">
                        📍 {loc.venue}, {loc.city}
                      </p>
                    )}
                    {loc.kind === "withheld" && (
                      <p class="text-sm text-gray-500 mt-1">
                        📍 {t("venue.tba")}, {loc.city}
                      </p>
                    )}
                    {loc.kind === "city-only" && (
                      <p class="text-sm text-gray-500 mt-1">
                        📍 {loc.city}
                      </p>
                    )}
                  </>
                );
              })()}
            </div>

            <!-- Sessions list -->
            <div class="p-4 space-y-2">
              {sessions.map((session) => <SessionRow session={session} speakers={scheduleSpeakers} />)}
            </div>
          </div>

          <p class="text-xs text-gray-500 text-center mt-4">
            {finished
              ? t("schedule.past.note")
              : lang === "tr"
                ? "Program değişikliğe tabidir. Güncel bilgi için bizi takip edin."
                : "Schedule is subject to change. Follow us for updates."}
          </p>
        </Fragment>
      ) : (
        <p class="text-gray-500 text-center py-12">
          {finished ? t("schedule.past.none") : t("schedule.none")}
        </p>
      )
    }
  </div>
</BaseLayout>
