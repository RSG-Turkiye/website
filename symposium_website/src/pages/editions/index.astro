---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditionCard from "../../components/EditionCard.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getCurrentEdition, getPastEditions } from "../../lib/editions-content";
import { getCurrentContent, withOverlayContent } from "../../lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// An edition still ahead of us is not archive material -- listing it in the
// same grid as the finished ones, under a heading that calls the page an
// archive, read as though the symposium had already happened.
const { state, entry: current } = await getCurrentEdition();
const upcoming = state === "upcoming" ? current : null;
const effectiveUpcoming = upcoming
  ? withOverlayContent(upcoming.data, await getCurrentContent())
  : null;
const pastEditions = await getPastEditions();
---

<BaseLayout
  pageTitle={t("nav.editions")}
>
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("nav.editions")}</h1>
      <p class="text-white/70">
        {lang === "tr"
          ? "2012'den bu yana RSG-Türkiye öğrenci sempozyumları"
          : "RSG-Türkiye student symposiums since 2012"}
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 py-12 space-y-12">
    {upcoming && (
      <section>
        <h2 class="text-xl font-bold text-navy mb-5">{t("editions.upcoming.heading")}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <EditionCard
            edition={upcoming.data}
            lang={lang}
            effective={effectiveUpcoming}
            badge={t("editions.badge.upcoming")}
          />
        </div>
      </section>
    )}

    {pastEditions.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-navy mb-5">{t("editions.past.heading")}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pastEditions.map((edition) => (
            <EditionCard
              edition={edition.data}
              lang={lang}
              badge={state === "just-held" && edition.data.year === current?.data.year
                ? t("edition.justheld.badge")
                : undefined}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
