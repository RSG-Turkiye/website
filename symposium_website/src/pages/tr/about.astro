---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getCurrentEdition, getPastEditions } from "../../lib/editions-content";
import EditionCard from "../../components/EditionCard.astro";
import { symposiumsHeld } from "../../lib/editions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const held = symposiumsHeld((await getCollection("editions")).map((e) => e.data), new Date());
const { entry: upcoming } = await getCurrentEdition();
const past = await getPastEditions();
---

<BaseLayout pageTitle={t("about.title")}>
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("about.title")}</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-navy mb-4">{t("about.mission.title")}</h2>
    <p class="text-gray-600 leading-relaxed">{t("about.mission.body")}</p>
    <div class="mt-8 grid sm:grid-cols-3 gap-4">
      {[
        { label: "Kuruluş Yılı", value: "2012" },
        { label: "Sempozyum", value: String(held) },
        { label: "Üye Ağı", value: "ISCB SC" },
      ].map(({ label, value }) => (
        <div class="bg-navy-light rounded-xl p-5 text-center">
          <p class="text-3xl font-bold text-navy">{value}</p>
          <p class="text-sm text-gray-500 mt-1">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-navy-light py-16">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">{t("about.history.title")}</h2>
      {upcoming && (
        <div class="mb-10">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-600 mb-4">
            {t("editions.upcoming.heading")}
          </h3>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <EditionCard edition={upcoming.data} lang={lang} badge={t("editions.badge.upcoming")} />
          </div>
        </div>
      )}

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {past.map((edition) => <EditionCard edition={edition.data} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>
