---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SponsorLogo from "../../components/SponsorLogo.astro";
import EditionCta from "../../components/EditionCta.astro";
import EventJsonLd from "../../components/EventJsonLd.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getSponsorsByEdition } from "../../data/sponsors";
import { getUpcomingEdition, getPastEditions } from "../../lib/editions-content";
import { locationFor, titleFor, subtitleFor } from "../../lib/editions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const latestSponsors = getSponsorsByEdition(2024);
const recentEditions = (await getPastEditions()).slice(0, 3);

const upcoming = await getUpcomingEdition();
const heading = upcoming ? titleFor(upcoming.data, lang) : "";
const theme = upcoming ? subtitleFor(upcoming.data, lang) : "";
const place = upcoming ? locationFor(upcoming.data) : { kind: "hidden" as const };
const startsAt = upcoming?.data.startDate?.toISOString() ?? "";

const BANNER = "https://res.cloudinary.com/dyuf14ra5/image/upload/v1774606559/rsgturkey/symposium/2021/05/RSG_symposium_banner-scaled.jpg";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout pageTitle={t("nav.home")} image={BANNER} translationUrl="/">
  {upcoming && <EventJsonLd edition={upcoming.data} url={canonical} lang={lang} />}
  <section class="relative bg-navy text-white overflow-hidden min-h-[90vh] flex items-center">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${BANNER}')`}></div>
    <div class="absolute inset-0 bg-navy/75"></div>
    <div class="relative max-w-7xl mx-auto px-6 py-24 flex flex-col items-center text-center gap-6 w-full">
      <img src="/logo/rsgturkey_logo_white.png" alt="RSG-Türkiye" class="h-16 w-auto mb-2" />
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight max-w-3xl">{t("hero.tagline")}</h1>
      <p class="text-lg text-white/80 max-w-2xl leading-relaxed">{t("hero.subtitle")}</p>
      {upcoming && (
        <div class="flex flex-col items-center gap-3 mt-2">
          <span class="text-white/50 text-xs uppercase tracking-widest">Sonraki Edisyon</span>
          <h2 class="text-2xl sm:text-3xl font-bold">{heading}</h2>
          {theme && <p class="text-white/80 text-lg max-w-2xl">{theme}</p>}
          <p class="text-white/90 font-medium">
            {upcoming.data.startDate?.toLocaleDateString("tr-TR", {
              day: "numeric", month: "long", year: "numeric",
            })}
          </p>
          <p class="text-white/70 text-sm">
            {place.kind === "full" && `${place.venue}, ${place.city}`}
            {place.kind === "withheld" && `${place.city} · ${t("venue.tba")}`}
            {place.kind === "city-only" && place.city}
          </p>
          <p
            id="countdown"
            class="text-white/60 text-sm tabular-nums"
            data-starts-at={startsAt}
            data-days-label={t("hero.countdown.days")}
          ></p>
          <EditionCta edition={upcoming.data} lang={lang} />
        </div>
      )}
      <div class="flex flex-wrap justify-center gap-4 mt-2">
        <a href="#about" class="px-6 py-3 rounded-lg bg-white text-navy font-semibold hover:bg-navy-light transition-colors text-sm">{t("hero.cta.about")}</a>
        <a href="/tr/editions" class="px-6 py-3 rounded-lg border border-white/30 text-white font-semibold hover:bg-white/10 transition-colors text-sm">{t("nav.editions")}</a>
      </div>
      <a href="#about" class="mt-8 text-white/40 hover:text-white/70 transition-colors animate-bounce">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </a>
    </div>
  </section>

  <section id="about" class="max-w-7xl mx-auto px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-navy mb-4">{t("home.about.title")}</h2>
      <p class="text-gray-600 leading-relaxed text-lg">{t("home.about.body")}</p>
      <div class="mt-10 grid sm:grid-cols-3 gap-4">
        {[
          { label: "Kuruluş Yılı", value: "2012" },
          { label: "Edisyon", value: "12+" },
          { label: "Üye Ağı", value: "ISCB SC" },
        ].map(({ label, value }) => (
          <div class="bg-navy-light rounded-xl p-5 text-center">
            <p class="text-3xl font-bold text-navy">{value}</p>
            <p class="text-sm text-gray-500 mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="editions" class="bg-navy-light py-20 scroll-mt-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-navy">{t("nav.editions")}</h2>
        <a href="/tr/editions" class="text-sm text-navy-mid hover:text-navy transition-colors font-medium">Tümünü gör →</a>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {recentEditions.map((edition) => (
          <a href={`/tr/editions/${edition.data.year}`} class="group bg-white rounded-xl border border-border overflow-hidden flex flex-col hover:shadow-lg transition-shadow">
            {edition.data.posterImage && (
              <div class="aspect-video overflow-hidden bg-navy-light">
                <img src={edition.data.posterImage} alt={titleFor(edition.data, lang)} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
            )}
            <div class="p-4 flex flex-col gap-1.5 flex-1">
              <span class="bg-navy text-white text-xs font-bold px-2 py-0.5 rounded w-fit">{edition.data.year}</span>
              <h3 class="font-semibold text-navy text-sm leading-snug">{titleFor(edition.data, lang)}</h3>
              {(() => {
                const loc = locationFor(edition.data);
                return (
                  loc.kind !== "hidden" && (
                    <p class="text-xs text-gray-400">📍 {loc.city}</p>
                  )
                );
              })()}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="sponsors" class="max-w-7xl mx-auto px-6 py-20 scroll-mt-16">
    <h2 class="text-2xl font-bold text-navy text-center mb-8">{t("home.sponsors.title")}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
      {latestSponsors.map((sp) => <SponsorLogo sponsor={sp} />)}
    </div>
    <div class="text-center mt-8">
      <a href="/tr/sponsors" class="text-sm text-navy-mid hover:text-navy transition-colors font-medium">Tüm sponsorları gör →</a>
    </div>
  </section>
</BaseLayout>

<script>
  const el = document.getElementById("countdown");
  const startsAt = el?.dataset.startsAt;
  const daysLabel = el?.dataset.daysLabel ?? "";
  if (el && startsAt) {
    const target = new Date(startsAt).getTime();
    const tick = () => {
      const days = Math.ceil((target - Date.now()) / 86_400_000);
      el.textContent = days > 0 ? `${days} ${daysLabel}` : "";
    };
    tick();
    setInterval(tick, 60_000);
  }
</script>
