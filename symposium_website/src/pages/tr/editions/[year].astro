---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SpeakerCard from "../../../components/SpeakerCard.astro";
import { useTranslations, getLangFromUrl } from "../../../i18n/ui";
import { getCollection, render } from "astro:content";
import { getSpeakerBySlug, getCurrentContent } from "../../../lib/content";
import { getCurrentEdition } from "../../../lib/editions-content";
import { locationFor, titleFor, subtitleFor } from "../../../lib/editions";

export async function getStaticPaths() {
  const editions = await getCollection("editions");
  return editions.map((edition) => ({
    params: { year: String(edition.data.year) },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The Turkish body when there is one, the English body when there is not --
// a missing translation shows what this page showed before rather than
// nothing at all.
const trBody = (await getCollection("editionsTr")).find((e) => e.data.year === edition.data.year);
const { Content } = await render(trBody ?? edition);
const editionSpeakers = (
  await Promise.all(
    edition.data.speakers.map((slug) => getSpeakerBySlug(edition.data.year, slug))
  )
).filter(Boolean);

// The frontmatter `speakers:` list is hand-maintained and empty for an edition
// whose speakers were entered through the CMS. Rather than show an empty grid
// until someone remembers to write that list, the current edition -- the one
// still ahead, or the one that just finished -- falls back to the same merged
// content /speakers renders from.
const { entry: currentEntry } = await getCurrentEdition();
const speakers =
  editionSpeakers.length > 0
    ? editionSpeakers
    : currentEntry?.data.year === edition.data.year
      ? (await getCurrentContent())?.speakers ?? []
      : [];
const title = titleFor(edition.data, lang);
const subtitle = subtitleFor(edition.data, lang);
---

<BaseLayout
  pageTitle={title}
  image={edition.data.posterImage}
>
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-3">
        <a href="/tr/editions" class="text-white/50 hover:text-white text-sm transition-colors">← {t("nav.editions")}</a>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-2">{title}</h1>
      {subtitle && <p class="text-white/70 text-lg">{subtitle}</p>}
      <div class="flex flex-wrap gap-4 mt-4 text-sm text-white/60">
        {edition.data.date && <span>📅 {edition.data.date}</span>}
        {(() => {
          const loc = locationFor(edition.data);
          return (
            <>
              {loc.kind === "full" && (
                <span>📍 {loc.venue}, {loc.city}</span>
              )}
              {loc.kind === "withheld" && (
                <span>📍 {t("venue.tba")}, {loc.city}</span>
              )}
              {loc.kind === "city-only" && (
                <span>📍 {loc.city}</span>
              )}
            </>
          );
        })()}
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    {edition.data.posterImage && (
      <div class="rounded-xl overflow-hidden border border-border max-h-96 flex items-center justify-center bg-navy-light">
        <img src={edition.data.posterImage} alt={title} class="max-h-96 w-auto object-contain" />
      </div>
    )}
    {speakers.length > 0 && (
      <div>
        <h2 class="text-xl font-bold text-navy mb-5">{t("nav.speakers")}</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {speakers.map((sp) => sp && <SpeakerCard speaker={sp} />)}
        </div>
      </div>
    )}
    <div class="prose-content"><Content /></div>
    {edition.data.galleryImages.length > 0 && (
      <div>
        <h2 class="text-xl font-bold text-navy mb-5">Galeri</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {edition.data.galleryImages.map((img) => (
            <div class="aspect-video rounded-lg overflow-hidden bg-navy-light">
              <img src={img} alt={`${edition.data.year} sempozyumu`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    )}
    <div class="border-t border-border pt-8">
      <a href="/tr/editions" class="text-navy-mid hover:text-navy transition-colors text-sm">← {t("nav.editions")}</a>
    </div>
  </div>
</BaseLayout>
