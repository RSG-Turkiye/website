---
// Build time. These pages are rebuilt when the CMS saves, so "now" is at
// worst as old as the last deploy.
const now = new Date();

import BaseLayout from "../../layouts/BaseLayout.astro";
import VenueDetails from "../../components/VenueDetails.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getCurrentEdition } from "../../lib/editions-content";
import { getCurrentContent, withOverlayContent } from "../../lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { entry: edition } = await getCurrentEdition();
const content = await getCurrentContent();
const effectiveEdition = edition ? withOverlayContent(edition.data, content) : null;
---

<BaseLayout pageTitle={t("venue.title")}>
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("venue.title")}</h1>
      <p class="text-white/70 text-lg">{t("venue.subtitle")}</p>
    </div>
  </section>

  <VenueDetails lang={lang} edition={edition?.data ?? null} effectiveEdition={effectiveEdition} now={now} />
</BaseLayout>
