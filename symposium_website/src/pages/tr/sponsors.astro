---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SponsorsPage from "../../components/SponsorsPage.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getCurrentEdition } from "../../lib/editions-content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { entry: edition } = await getCurrentEdition();
const year = edition?.data.year ?? new Date().getFullYear();
---

<BaseLayout pageTitle={t("sponsors.title")}>
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("sponsors.title")}</h1>
      <p class="text-white/70 text-lg">{t("sponsors.subtitle")}</p>
    </div>
  </section>

  <SponsorsPage lang={lang} year={year} />
</BaseLayout>
