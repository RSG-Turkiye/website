---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpeakerCard from "../../components/SpeakerCard.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getSpeakers, getCurrentContent } from "../../lib/content";
import { getCurrentEdition } from "../../lib/editions-content";
import { titleFor } from "../../lib/editions";
import { getCollection } from "astro:content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const editions = await getCollection("editions");
const editionYears = [...new Set(editions.map((e) => e.data.year))].sort((a, b) => b - a);

const { state, entry: upcoming } = await getCurrentEdition();
const upcomingContent = await getCurrentContent();
const finished = state === "finished";
const hasUpcomingSpeakers = upcomingContent ? upcomingContent.speakers.length > 0 : false;

// The upcoming edition's speakers come from the merged overlay content, not
// a fresh repo-only read -- everything else in the archive reads straight
// from the collection.
const speakersByYear = new Map(
  await Promise.all(
    editionYears.map(async (year) => {
      if (upcoming && year === upcoming.data.year && upcomingContent) {
        return [year, upcomingContent.speakers] as const;
      }
      return [year, await getSpeakers(year)] as const;
    })
  )
);
---

<BaseLayout pageTitle={t("speakers.title")} translationUrl="/speakers">
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("speakers.title")}</h1>
      <p class="text-white/70 text-lg">{t("speakers.subtitle")}</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-6 py-12 space-y-16">
    {!hasUpcomingSpeakers && (
      <p class="text-gray-500 text-center py-16">{finished ? t("speakers.past.none") : t("speakers.none")}</p>
    )}
    {editionYears.map((year) => {
      const editionSpeakers = speakersByYear.get(year) ?? [];
      if (editionSpeakers.length === 0) return null;
      const edition = editions.find((e) => e.data.year === year);
      return (
        <div>
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-xl font-bold text-navy">{year}</h2>
            {edition && <span class="text-sm text-gray-500">{titleFor(edition.data, lang)}</span>}
            <div class="flex-1 h-px bg-border" />
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            {editionSpeakers.map((sp) => <SpeakerCard speaker={sp} />)}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>
