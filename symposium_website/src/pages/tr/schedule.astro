---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SessionRow from "../../components/SessionRow.astro";
import { useTranslations, getLangFromUrl } from "../../i18n/ui";
import { getSessionsByEdition } from "../../data/sessions";
import { getUpcomingEdition } from "../../lib/editions-content";
import { locationFor, titleFor } from "../../lib/editions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const edition = await getUpcomingEdition();
const sessions = edition ? getSessionsByEdition(edition.data.year) : [];
---

<BaseLayout pageTitle={t("schedule.title")} translationUrl="/schedule">
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{t("schedule.title")}</h1>
      <p class="text-white/70 text-lg">{t("schedule.subtitle")}</p>
    </div>
  </section>
  <div class="max-w-3xl mx-auto px-6 py-12">
    {
      edition && sessions.length > 0 ? (
        <Fragment>
          <div class="bg-white rounded-xl border border-border overflow-hidden">
            <div class="bg-navy-light px-6 py-4 border-b border-border">
              <div class="flex items-center justify-between">
                <h2 class="font-semibold text-navy">{titleFor(edition.data, lang)}</h2>
                <span class="text-sm text-gray-500">{edition.data.date}</span>
              </div>
              {(() => {
                const loc = locationFor(edition.data);
                return (
                  <>
                    {loc.kind === "full" && (
                      <p class="text-sm text-gray-500 mt-1">
                        📍 {loc.venue}, {loc.city}
                      </p>
                    )}
                    {loc.kind === "withheld" && (
                      <p class="text-sm text-gray-500 mt-1">
                        📍 {t("venue.tba")}, {loc.city}
                      </p>
                    )}
                    {loc.kind === "city-only" && (
                      <p class="text-sm text-gray-500 mt-1">
                        📍 {loc.city}
                      </p>
                    )}
                  </>
                );
              })()}
            </div>
            <div class="p-4 space-y-2">
              {sessions.map((session) => <SessionRow session={session} />)}
            </div>
          </div>
          <p class="text-xs text-gray-400 text-center mt-4">Program değişikliğe tabidir. Güncel bilgi için bizi takip edin.</p>
        </Fragment>
      ) : (
        <p class="text-gray-500 text-center py-12">{t("schedule.none")}</p>
      )
    }
  </div>
</BaseLayout>
