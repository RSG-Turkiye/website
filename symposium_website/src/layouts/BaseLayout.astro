---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import { getCurrentContent } from "../lib/content";
import type { NavState } from "../lib/nav";
import { alternatesFor } from "../lib/hreflang";

interface Props {
  pageTitle: string;
  description?: string;
  image?: string;
  /** Optional override. Left off, the language toggle is derived from the
   * current path by the same `alternatesFor` that builds the hreflang tags,
   * so the two can never disagree -- and a new page cannot ship with a
   * toggle that silently falls back to the homepage because someone forgot
   * to pass this. */
  translationUrl?: string;
}

const { pageTitle, description, image, translationUrl } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Merged content, not the repo's alone: /schedule, /speakers and /committee
// each render from the overlay too, so a nav built from repo reads would hide
// pages that exist. An edition entered entirely through the CMS -- the case
// this whole overlay exists for -- would render every page correctly and link
// to none of them. getCurrentContent() is memoised, so this costs one fetch
// per build rather than one per page.
const content = await getCurrentContent();
const navState: NavState = {
  hasSchedule: (content?.sessions.length ?? 0) > 0,
  hasSpeakers: (content?.speakers.length ?? 0) > 0,
  hasCommittee: (content?.committee.length ?? 0) > 0,
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || "https://res.cloudinary.com/dyuf14ra5/image/upload/f_auto,q_auto,c_limit,w_1600/v1774606559/rsgturkey/symposium/2021/05/RSG_symposium_banner-scaled.jpg";
const metaDesc = description || t("site.description");
const alternates = alternatesFor(Astro.url.pathname);
const toggleUrl = translationUrl ?? (alternates ? (lang === "en" ? alternates.tr : alternates.en) : "/");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle} | {t("site.title")}</title>
    <meta name="description" content={metaDesc} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />

    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site).href} />
        <link rel="alternate" hreflang="tr" href={new URL(alternates.tr, Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
      </>
    )}

    <link rel="icon" type="image/png" href="/logo/rsgturkey_logo.png" />
  </head>
  <body>
    <Header lang={lang} translationUrl={toggleUrl} navState={navState} />
    <main class="pt-16">
      <slot />
    </main>
    <Footer lang={lang} navState={navState} />
  </body>
</html>
