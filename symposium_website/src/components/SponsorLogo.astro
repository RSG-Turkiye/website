---
import type { Sponsor } from "../data/sponsors";

interface Props {
  sponsor: Sponsor;
}

const { sponsor } = Astro.props;

// Not every supporter has a site we can link. `<a href="">` resolves to the
// current page, so a card with no URL would be a link that reloads.
const Tag = sponsor.url ? "a" : "div";
const linkProps = sponsor.url
  ? { href: sponsor.url, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    "flex h-full flex-col items-center justify-center gap-3 bg-white rounded-xl border border-border p-6 group",
    sponsor.url && "hover:shadow-md transition-shadow",
  ]}
  title={sponsor.name}
>
  {
    sponsor.logo ? (
      <img
        src={sponsor.logo}
        alt={sponsor.name}
        class="max-h-16 max-w-[180px] w-auto object-contain grayscale group-hover:grayscale-0 transition-all"
        loading="lazy"
      />
    ) : (
      <span class="text-navy font-semibold text-lg text-center">{sponsor.name}</span>
    )
  }
  {sponsor.description && <p class="text-xs text-gray-500 text-center">{sponsor.description}</p>}
</Tag>
