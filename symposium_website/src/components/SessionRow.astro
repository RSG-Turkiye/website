---
import type { Session, SessionType, Speaker } from "../lib/content";

const sessionTypeColors: Record<SessionType, string> = {
  opening: "bg-navy text-white",
  keynote: "bg-red text-white",
  workshop: "bg-[#0E7490] text-white",
  panel: "bg-[#7C3AED] text-white",
  talk: "bg-navy-mid text-white",
  company: "bg-[#92400E] text-white",
  poster: "bg-[#065F46] text-white",
  networking: "bg-[#1D4ED8] text-white",
  break: "bg-border text-navy",
  closing: "bg-navy text-white",
};

interface Props {
  session: Session;
  speakers: Speaker[];
}

const { session, speakers: allSpeakers } = Astro.props;
const sessionSpeakers = allSpeakers.filter((s) =>
  session.speakerSlugs.includes(s.slug)
);
const colorClass = sessionTypeColors[session.type];
const isBreak = session.type === "break";
---

<div
  class:list={[
    "flex items-start gap-3 rounded-lg px-4 py-3",
    isBreak ? "bg-border/40 opacity-70" : "bg-white border border-border",
  ]}
>
  <!-- Type badge -->
  <span
    class:list={[
      "shrink-0 mt-0.5 text-xs font-semibold px-2 py-0.5 rounded-full capitalize",
      colorClass,
    ]}
  >
    {session.type}
  </span>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    {
      session.time ? (
        <div class="flex items-baseline gap-2">
          <span class="text-xs font-medium text-gray-400 shrink-0">
            {session.time}
            {session.endTime && `–${session.endTime}`}
          </span>
          <p class:list={["font-medium text-sm leading-snug", isBreak ? "text-gray-500" : "text-navy"]}>
            {session.title}
          </p>
        </div>
      ) : (
        <p class:list={["font-medium text-sm leading-snug", isBreak ? "text-gray-500" : "text-navy"]}>
          {session.title}
        </p>
      )
    }

    {
      session.description && (
        <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">{session.description}</p>
      )
    }

    {
      sessionSpeakers.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-1.5">
          {sessionSpeakers.map((sp) => (
            <span class="text-xs text-navy-mid font-medium">{sp.name}</span>
          ))}
        </div>
      )
    }
  </div>
</div>
