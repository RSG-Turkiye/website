---
/**
 * One speaker in a grid, and -- when there is a bio -- the dialog that shows
 * all of it.
 *
 * The card clamps the bio to four lines, which is right for a grid and wrong
 * for a keynote speaker whose bio is 1,500 characters. So a card with a bio
 * opens a native <dialog> holding the whole thing. It is rendered here, beside
 * its card, so every page that uses the card gets it without any wiring of its
 * own, and it is found from the card rather than by id: the speakers page
 * lists every edition, and a returning speaker has the same slug each year.
 *
 * The card's button is stretched over the whole card; the LinkedIn link sits
 * above it, since a link inside a button is not allowed.
 */
import type { Speaker } from "../lib/content";
import { drivePhotoUrl } from "../lib/photo-url";
import { useTranslations, getLangFromUrl } from "../i18n/ui";

interface Props {
  speaker: Speaker;
  compact?: boolean;
}

const { speaker, compact = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const photo = speaker.photo ? drivePhotoUrl(speaker.photo) : "";
const affiliation = [speaker.position, speaker.company].filter(Boolean).join(" · ");
const hasBio = Boolean(speaker.bio?.trim());
const initials = speaker.name
  .split(" ")
  .filter((w) => /^[A-ZÇĞİÖŞÜ]/.test(w))
  .slice(-2)
  .map((w) => w[0])
  .join("");

const linkedinIcon =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";
---

<div
  class="speaker-card relative bg-white rounded-xl border border-border overflow-hidden flex flex-col transition-shadow hover:shadow-lg focus-within:shadow-lg"
>
  <!-- Photo -->
  <div class="aspect-square bg-navy-light flex items-center justify-center overflow-hidden">
    {
      photo ? (
        <img
          src={photo}
          alt={speaker.name}
          class="w-full h-full object-cover object-top"
          loading="lazy"
        />
      ) : (
        <span class="text-3xl font-bold text-navy-mid">{initials}</span>
      )
    }
  </div>

  <!-- Info -->
  <div class="p-4 flex flex-col gap-2 flex-1">
    <h3 class="font-semibold text-navy text-base leading-snug">{speaker.name}</h3>
    {affiliation && <p class="text-sm text-gray-500 leading-snug">{affiliation}</p>}

    {
      !compact && hasBio && (
        <p class="text-sm text-gray-600 leading-relaxed line-clamp-4 mt-1">{speaker.bio}</p>
      )
    }

    {
      hasBio && (
        <button
          type="button"
          data-speaker-open
          class="self-start text-xs font-medium text-navy-mid hover:text-navy transition-colors pt-1 after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid rounded"
        >
          {t("speakers.readMore")} →
        </button>
      )
    }

    <!-- Links -->
    {
      speaker.linkedin && (
        <a
          href={speaker.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 mt-auto self-start inline-flex items-center gap-1.5 text-xs text-navy-mid hover:text-navy transition-colors pt-2"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={linkedinIcon} />
          </svg>
          LinkedIn
        </a>
      )
    }
  </div>

  {
    hasBio && (
      <dialog
        data-speaker-dialog
        aria-label={speaker.name}
        class="speaker-dialog m-auto p-0 w-[calc(100%-2rem)] max-w-2xl rounded-2xl border border-border bg-white shadow-xl backdrop:bg-navy/60"
      >
        <div class="relative max-h-[85vh] overflow-y-auto p-6 sm:p-8">
          <button
            type="button"
            data-speaker-close
            aria-label={t("speakers.close")}
            class="absolute top-3 right-3 w-9 h-9 flex items-center justify-center rounded-full text-gray-500 hover:bg-navy-light hover:text-navy transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-mid"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>

          <div class="flex flex-col sm:flex-row gap-5 sm:gap-6 mb-5 pr-8">
            <div class="w-28 h-28 sm:w-36 sm:h-36 shrink-0 rounded-xl bg-navy-light flex items-center justify-center overflow-hidden">
              {
                photo ? (
                  <img src={photo} alt="" class="w-full h-full object-cover object-top" loading="lazy" />
                ) : (
                  <span class="text-3xl font-bold text-navy-mid">{initials}</span>
                )
              }
            </div>
            <div class="flex flex-col gap-1.5 justify-center">
              <h2 class="text-xl font-bold text-navy leading-snug">{speaker.name}</h2>
              {affiliation && <p class="text-sm text-gray-500 leading-snug">{affiliation}</p>}
              {
                speaker.linkedin && (
                  <a
                    href={speaker.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="self-start inline-flex items-center gap-1.5 text-xs text-navy-mid hover:text-navy transition-colors pt-1"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={linkedinIcon} />
                    </svg>
                    LinkedIn
                  </a>
                )
              }
            </div>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed whitespace-pre-line">{speaker.bio}</p>
        </div>
      </dialog>
    )
  }
</div>

<script>
  // One delegated listener for every card on the page. Astro includes this
  // script once however many cards render.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const open = target.closest("[data-speaker-open]");
    if (open) {
      const dialog = open.closest(".speaker-card")?.querySelector<HTMLDialogElement>("[data-speaker-dialog]");
      dialog?.showModal();
      return;
    }

    if (target.closest("[data-speaker-close]")) {
      target.closest("dialog")?.close();
      return;
    }

    // A click on the backdrop lands on the <dialog> itself: it has no padding,
    // so anything inside the box hits the inner wrapper instead.
    if (target instanceof HTMLDialogElement && target.matches("[data-speaker-dialog]")) {
      target.close();
    }
  });
</script>

<style>
  /* Keep the page behind the dialog from scrolling along with it. */
  :global(html:has(.speaker-dialog[open])) {
    overflow: hidden;
  }
</style>
