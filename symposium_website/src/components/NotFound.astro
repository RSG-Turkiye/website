---
/**
 * The 404 body, shared by the English and Turkish pages.
 *
 * There was one 404, built once, and getLangFromUrl saw "/404" -- so it was
 * English wherever it appeared. A reader who mistyped a URL under /tr/ got an
 * English page whose one button led out of Turkish.
 */
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = lang === "tr" ? "/tr/" : "/";
---

<section class="min-h-[60vh] flex items-center justify-center px-6">
  <div class="text-center">
    <p class="text-8xl font-bold text-navy-mid mb-4">404</p>
    <h1 class="text-2xl font-bold text-navy mb-3">{t("404.title")}</h1>
    <p class="text-gray-500 mb-8">{t("404.body")}</p>
    <a href={home} class="bg-navy text-white px-6 py-3 rounded-lg font-semibold hover:bg-navy-mid transition-colors text-sm">
      {t("404.home")}
    </a>
  </div>
</section>
