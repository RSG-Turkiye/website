# Copy to .env and fill in. .env is gitignored and never leaves your machine;
# this file is the list of what goes in it.
#
# Only needed to UPLOAD images. Nothing in the site's build, tests or preview
# reads these -- you can clone, run and contribute without them.

# Cloudinary, where every image on both sites is hosted. The cloud name is
# public (it is in every image URL); the key and secret are not.
# Find all three at: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=dyuf14ra5
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
